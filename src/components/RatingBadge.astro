---
import type { VerifiedRatingBenchmark } from '../data/types';

interface Props {
  benchmark: VerifiedRatingBenchmark;
  size?: 'sm' | 'md' | 'lg';
}

const { benchmark, size = 'md' } = Astro.props;
---

<div class:list={['rating-badge', `rating-badge-${size}`]}>
  <div class="score-pill">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
    </svg>
    <span class="score-value">{benchmark.score.toFixed(1)}</span>
    <span class="score-max">/{benchmark.maxScore}</span>
  </div>
  <div class="rating-meta">
    <span class="rating-source">{benchmark.source}</span>
    <span class="rating-count">({benchmark.observedReviewCountText} &bull; Checked {benchmark.dateObserved})</span>
  </div>
</div>

<style>
  .rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }

  .rating-badge-sm {
    font-size: 0.75rem;
  }

  .score-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background-color: var(--emerald-primary);
    color: white;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    line-height: 1;
  }

  .score-value {
    letter-spacing: -0.02em;
  }

  .score-max {
    font-size: 0.7em;
    opacity: 0.85;
  }

  .rating-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    color: var(--text-muted);
  }

  .rating-source {
    font-weight: 600;
    color: var(--text-secondary);
  }

  .rating-count {
    color: var(--text-muted);
  }
</style>

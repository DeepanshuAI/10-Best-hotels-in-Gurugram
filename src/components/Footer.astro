---
import { SITE_CONFIG } from '../lib/site-config';
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: Editorial Identity -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <div class="footer-brand-monogram" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-3M9 9h1M9 13h1M9 17h1M15 13h1M15 17h1" />
            </svg>
          </div>
          <span class="footer-brand-title font-serif">{SITE_CONFIG.name}</span>
        </div>
        <p class="footer-mission-statement">
          An independent, transit-aware accommodation publication for Gurugram (Gurgaon), Haryana. Built for corporate executives, event delegations, and discerning visitors seeking verified specifications and realistic commute times.
        </p>
        <div class="footer-audit-stamp">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Latest Fact Verification: {SITE_CONFIG.verificationAuditDate}</span>
        </div>
      </div>

      <!-- Col 2: Rankings & Comparisons -->
      <div class="footer-col">
        <h3 class="footer-col-title">Rankings & Comparisons</h3>
        <ul class="footer-nav-list" role="list">
          <li><a href="/">Top 18 Hotel Rankings</a></li>
          <li><a href="/compare/">Compare Hotels Matrix</a></li>
          <li><a href="/luxury-hotels-in-gurugram/">5-Star Luxury Rankings</a></li>
          <li><a href="/business-hotels-in-gurugram/">Corporate Business Rankings</a></li>
          <li><a href="/budget-hotels-in-gurugram/">Smart Budget Rankings</a></li>
          <li><a href="/guides/where-to-stay-in-gurugram/">Neighborhood District Guide</a></li>
        </ul>
      </div>

      <!-- Col 3: Business Corridors -->
      <div class="footer-col">
        <h3 class="footer-col-title">Business Corridors</h3>
        <ul class="footer-nav-list" role="list">
          <li><a href="/hotels-near-cyber-city/">Hotels Near DLF Cyber City</a></li>
          <li><a href="/hotels-near-golf-course-road/">Hotels Near Golf Course Road</a></li>
          <li><a href="/hotels-near-udyog-vihar/">Hotels Near Udyog Vihar</a></li>
          <li><a href="/hotels-near-mg-road-gurugram/">Hotels Near MG Road & Sec 29</a></li>
          <li><a href="/hotels-near-sohna-road/">Hotels Near Sohna Road</a></li>
        </ul>
      </div>

      <!-- Col 4: Trust & Methodology -->
      <div class="footer-col">
        <h3 class="footer-col-title">Standards & Trust</h3>
        <ul class="footer-nav-list" role="list">
          <li><a href="/how-we-choose-hotels/">Selection Methodology</a></li>
          <li><a href="/editorial-policy/">Editorial Standards & Disclosures</a></li>
          <li><a href="/corrections/">Submit a Correction</a></li>
          <li><a href="/about/">About This Publication</a></li>
          <li><a href="/contact/">Contact Our Desk</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    <!-- Editorial Disclosure Notice -->
    <div class="footer-disclosure-panel">
      <p>
        <strong>Editorial Disclosure:</strong> Best Hotels in Gurugram is an independent, non-commercial research directory. We do not accept paid listings, sponsored positions, or financial incentives for rankings. All hotel trademarks, brand names, and visual representations are property of their respective owners and are used strictly under fair-use editorial commentary and public guidance.
      </p>
    </div>

    <!-- Bottom Copyright Bar -->
    <div class="footer-legal-bar">
      <p class="copyright-text">&copy; {new Date().getFullYear()} Best Hotels in Gurugram. All rights reserved. Gurugram, Haryana 122002, India.</p>
      <div class="footer-legal-links">
        <a href="/privacy-policy/">Privacy</a>
        <span aria-hidden="true">&bull;</span>
        <a href="/corrections/">Corrections</a>
        <span aria-hidden="true">&bull;</span>
        <a href="/how-we-choose-hotels/">Methodology</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-dark);
    color: #94A3B8;
    padding-top: 4rem;
    padding-bottom: 2.5rem;
    margin-top: 5rem;
    border-top: 1px solid var(--border-dark);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .footer-brand-monogram {
    width: 2.25rem;
    height: 2.25rem;
    background-color: #1E3A5F;
    color: #E2E8F0;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .footer-brand-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #F8FAFC;
    letter-spacing: -0.01em;
  }

  .footer-mission-statement {
    font-size: 0.875rem;
    line-height: 1.65;
    color: #94A3B8;
    margin-bottom: 1.25rem;
  }

  .footer-audit-stamp {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    background-color: rgba(20, 83, 45, 0.25);
    border: 1px solid rgba(74, 222, 128, 0.25);
    color: #86EFAC;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .footer-col-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #F1F5F9;
    margin-bottom: 1rem;
  }

  .footer-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-nav-list a {
    color: #94A3B8;
    font-size: 0.875rem;
    transition: color var(--transition-fast);
  }

  .footer-nav-list a:hover {
    color: #FFFFFF;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-disclosure-panel {
    padding: 1.25rem 1.5rem;
    background-color: var(--bg-dark-surface);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-dark);
    margin-bottom: 2rem;
  }

  .footer-disclosure-panel p {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #94A3B8;
    margin-bottom: 0;
  }

  .footer-disclosure-panel strong {
    color: #E2E8F0;
  }

  .footer-legal-bar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-dark);
    font-size: 0.8125rem;
    color: #64748B;
  }

  @media (min-width: 640px) {
    .footer-legal-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .copyright-text {
    margin-bottom: 0;
    font-size: inherit;
    color: inherit;
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-legal-links a {
    color: #94A3B8;
  }

  .footer-legal-links a:hover {
    color: #FFFFFF;
  }
</style>

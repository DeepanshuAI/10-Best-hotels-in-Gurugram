---
import { SITE_CONFIG } from '../lib/site-config';
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: Mission & Identity -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <div class="footer-brand-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-3M9 9h1M9 13h1M9 17h1M15 13h1M15 17h1" />
            </svg>
          </div>
          <span class="footer-brand-name">{SITE_CONFIG.name}</span>
        </div>
        <p class="footer-description">
          An independent, transit-aware accommodation directory for Gurugram (Gurgaon), Haryana. Built for corporate travelers, executive delegations, and discerning visitors seeking verified property facts and realistic commute times.
        </p>
        <div class="footer-verification-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Latest Data Verification: {SITE_CONFIG.verificationAuditDate}</span>
        </div>
      </div>

      <!-- Col 2: Categories -->
      <div class="footer-col">
        <h3 class="footer-heading">Accommodation Tiers</h3>
        <ul class="footer-links" role="list">
          <li><a href="/luxury-hotels-in-gurugram/">Luxury Hotels in Gurugram</a></li>
          <li><a href="/business-hotels-in-gurugram/">Business & Corporate Stays</a></li>
          <li><a href="/budget-hotels-in-gurugram/">Verified Budget Hotels</a></li>
          <li><a href="/guides/where-to-stay-in-gurugram/">Gurugram Neighborhood Guide</a></li>
        </ul>
      </div>

      <!-- Col 3: Business Corridors -->
      <div class="footer-col">
        <h3 class="footer-heading">Business Corridors</h3>
        <ul class="footer-links" role="list">
          <li><a href="/hotels-near-cyber-city/">Hotels Near DLF Cyber City</a></li>
          <li><a href="/hotels-near-golf-course-road/">Hotels Near Golf Course Road</a></li>
          <li><a href="/hotels-near-udyog-vihar/">Hotels Near Udyog Vihar</a></li>
          <li><a href="/hotels-near-mg-road-gurugram/">Hotels Near MG Road & Sec 29</a></li>
          <li><a href="/hotels-near-sohna-road/">Hotels Near Sohna Road</a></li>
        </ul>
      </div>

      <!-- Col 4: Trust & Methodology -->
      <div class="footer-col">
        <h3 class="footer-heading">Editorial & Trust</h3>
        <ul class="footer-links" role="list">
          <li><a href="/how-we-choose-hotels/">Selection Methodology</a></li>
          <li><a href="/editorial-policy/">Editorial Standards & Disclosures</a></li>
          <li><a href="/corrections/">Submit a Correction</a></li>
          <li><a href="/about/">About This Directory</a></li>
          <li><a href="/contact/">Contact Our Desk</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    <!-- Editorial Disclosure Bar -->
    <div class="footer-disclosure">
      <p>
        <strong>Editorial Disclosure:</strong> Best Hotels in Gurugram is an independent, non-commercial research directory. We do not accept paid listings, sponsored positions, or financial incentives for rankings. All property names, trademarks, and logos are property of their respective owners and are used strictly for identification and editorial review purposes.
      </p>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Best Hotels in Gurugram. All rights reserved. Gurugram, Haryana 122002, India.</p>
      <div class="footer-bottom-links">
        <a href="/privacy-policy/">Privacy</a>
        <span>&bull;</span>
        <a href="/corrections/">Corrections</a>
        <span>&bull;</span>
        <a href="/how-we-choose-hotels/">Methodology</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-dark);
    color: #94A3B8;
    padding-top: 3.5rem;
    padding-bottom: 2rem;
    margin-top: 4rem;
    border-top: 1px solid #1E293B;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.875rem;
  }

  .footer-brand-icon {
    width: 2rem;
    height: 2rem;
    background-color: #064E3B;
    color: #34D399;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-brand-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: #F8FAFC;
  }

  .footer-description {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #94A3B8;
    margin-bottom: 1.25rem;
  }

  .footer-verification-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    background-color: rgba(5, 150, 105, 0.15);
    border: 1px solid rgba(5, 150, 105, 0.3);
    color: #34D399;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .footer-heading {
    font-size: 0.9375rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #F1F5F9;
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-links a {
    color: #94A3B8;
    font-size: 0.875rem;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: #34D399;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-disclosure {
    padding: 1.25rem;
    background-color: var(--bg-dark-surface);
    border-radius: var(--radius-md);
    border: 1px solid #1E293B;
    margin-bottom: 2rem;
  }

  .footer-disclosure p {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #94A3B8;
    margin-bottom: 0;
  }

  .footer-disclosure strong {
    color: #F1F5F9;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid #1E293B;
    font-size: 0.8125rem;
    color: #64748B;
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-bottom-links a {
    color: #94A3B8;
  }

  .footer-bottom-links a:hover {
    color: #34D399;
  }
</style>

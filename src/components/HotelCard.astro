---
import type { HotelRecord, HotelCategory } from '../data/types';
import { HOTELS } from '../data/hotels';
import { formatINR } from '../lib/site-config';

interface Props {
  hotel: HotelRecord;
  rank?: number;
  featured?: boolean;
}

const { hotel, rank: propRank, featured = false } = Astro.props;

// Determine directory ranking number (1-18)
const computedRank = propRank || (HOTELS.findIndex((h) => h.id === hotel.id) + 1) || 1;

const categoryLabelMap: Record<HotelCategory, string> = {
  luxury: '5-Star Luxury',
  business: 'Corporate Business',
  budget: 'Smart Budget',
  resort: 'Resort Sanctuary',
  boutique: 'Boutique Hotel',
};
---

<article 
  class:list={['hotel-ranking-row card', { 'ranking-row-leading': computedRank === 1, 'ranking-row-featured': featured }]} 
  data-hotel-id={hotel.id}
  data-category={hotel.category}
  data-district={hotel.primaryDistrict}
  data-districts={hotel.districts.join(',')}
  data-price={hotel.indicativeStartingRateINR}
  data-score={hotel.ratingBenchmark.score}
  data-name={hotel.officialName.toLowerCase()}
  data-rank={computedRank}
>
  <!-- 1. Left Architectural Ranking Badge -->
  <div class="row-rank-badge" aria-label={`Directory Rank #${computedRank}`}>
    <span class="rank-hash" aria-hidden="true">#</span>
    <span class="rank-digit">{String(computedRank).padStart(2, '0')}</span>
    <span class="rank-tier-tag">{categoryLabelMap[hotel.category] || hotel.category}</span>
  </div>

  <!-- 2. Central Editorial Content Column -->
  <div class="row-editorial-content">
    <!-- Top Metadata Eyebrow -->
    <div class="row-meta-eyebrow">
      <span class="eyebrow-locality">{hotel.address.locality}</span>
      <span class="eyebrow-sep" aria-hidden="true">&bull;</span>
      <span class="eyebrow-corridor">{hotel.primaryDistrict} Corridor</span>
      <span class="eyebrow-status">Verified Oct 2026</span>
    </div>

    <!-- Hotel Name & Direct Dossier Link -->
    <h3 class="row-hotel-name font-serif">
      <a href={`/hotels/${hotel.slug}/`} class="hotel-title-link">
        {hotel.officialName}
      </a>
    </h3>

    <!-- Justified "Best For" Suitability -->
    {hotel.bestFor && hotel.bestFor.length > 0 && (
      <div class="row-suitability-pill">
        <span class="suitability-kicker">Best for:</span>
        <span class="suitability-val">{hotel.bestFor[0]}</span>
      </div>
    )}

    <!-- Editorial Selection Rationale -->
    <p class="row-editorial-rationale">
      {hotel.editorialRationale || hotel.summary}
    </p>

    <!-- 2–3 Key Verified Differentiators -->
    <ul class="row-differentiators-list" role="list">
      {hotel.keyStrengths.slice(0, 3).map((strength) => (
        <li class="differentiator-item">
          <svg class="diff-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>{strength}</span>
        </li>
      ))}
    </ul>

    <!-- Bottom Facts Strip: Rating Benchmark, Tariff, Transit -->
    <div class="row-facts-strip">
      <!-- Benchmark -->
      <div class="fact-col fact-rating">
        <span class="fact-lbl">Public Rating:</span>
        <span class="fact-score">★ {hotel.ratingBenchmark.score} / {hotel.ratingBenchmark.maxScore}</span>
        <span class="fact-source">({hotel.ratingBenchmark.source.split(' ')[0]})</span>
      </div>

      <!-- Price -->
      <div class="fact-col fact-tariff">
        <span class="fact-lbl">Indicative Tariff:</span>
        <span class="fact-rate">{formatINR(hotel.indicativeStartingRateINR)}</span>
        <span class="fact-cycle">/ night</span>
      </div>

      <!-- Transit Commute -->
      <div class="fact-col fact-transit">
        <span class="fact-lbl">Highway Commute:</span>
        <span class="fact-commute">{hotel.transit.driveTimeToCyberCityMin}m Cyber City &bull; {hotel.transit.driveTimeToIGI_T3Min}m IGI T3</span>
      </div>
    </div>
  </div>

  <!-- 3. Right Supporting Visual & Dossier Link -->
  <div class="row-visual-action">
    <a href={`/hotels/${hotel.slug}/`} class="row-thumbnail-link" tabindex="-1" aria-hidden="true">
      <img
        src={hotel.heroImage.src}
        alt={hotel.heroImage.alt}
        width="340"
        height="210"
        loading="lazy"
        decoding="async"
        class="row-thumbnail"
      />
    </a>

    <div class="row-action-block">
      <a href={`/hotels/${hotel.slug}/`} class="btn btn-outline btn-sm row-cta-btn" aria-label={`View editorial dossier for ${hotel.officialName}`}>
        View Hotel Dossier
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
      <span class="action-subtext">Verified facilities & transit matrix</span>
    </div>
  </div>
</article>

<style>
  .hotel-ranking-row {
    display: grid;
    grid-template-columns: 1fr;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-neutral);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .hotel-ranking-row:hover {
    box-shadow: var(--shadow-hover);
    border-color: rgba(20, 83, 45, 0.35);
  }

  /* Desktop Layout: 3 Columns [Rank Badge (76px)] [Editorial Content (1fr)] [Supporting Photo & CTA (240px)] */
  @media (min-width: 900px) {
    .hotel-ranking-row {
      grid-template-columns: 78px 1fr 240px;
    }
  }

  /* 1. Rank Badge Column */
  .row-rank-badge {
    background-color: var(--bg-subtle);
    border-right: 1px solid var(--border-neutral);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 1.5rem 0.5rem;
    text-align: center;
    gap: 0.15rem;
  }

  @media (max-width: 899px) {
    .row-rank-badge {
      flex-direction: row;
      justify-content: space-between;
      border-right: none;
      border-bottom: 1px solid var(--border-neutral);
      padding: 0.75rem 1.25rem;
    }
  }

  .rank-hash {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--forest-primary);
    font-weight: 700;
  }

  .rank-digit {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    color: var(--navy-primary);
    letter-spacing: -0.02em;
  }

  .ranking-row-leading .rank-digit {
    color: var(--forest-primary);
  }

  .rank-tier-tag {
    margin-top: 0.5rem;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    line-height: 1.2;
    padding: 0.2rem 0.35rem;
    background-color: var(--bg-surface);
    border-radius: var(--radius-xs);
    border: 1px solid var(--border-subtle);
  }

  @media (max-width: 899px) {
    .rank-tier-tag {
      margin-top: 0;
    }
  }

  /* 2. Central Editorial Content Column */
  .row-editorial-content {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  @media (max-width: 640px) {
    .row-editorial-content {
      padding: 1.25rem;
    }
  }

  .row-meta-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 0.4rem;
  }

  .eyebrow-locality {
    font-weight: 600;
    color: var(--navy-secondary);
  }

  .eyebrow-sep {
    color: var(--border-neutral);
  }

  .eyebrow-status {
    margin-left: auto;
    font-size: 0.7rem;
    color: var(--forest-primary);
    font-weight: 600;
    background-color: var(--forest-soft);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-xs);
  }

  .row-hotel-name {
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.25;
    color: var(--navy-primary);
    margin: 0 0 0.5rem 0;
  }

  .hotel-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .hotel-title-link:hover {
    color: var(--forest-primary);
    text-decoration: underline;
  }

  /* Suitability Pill */
  .row-suitability-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    background-color: var(--bg-subtle);
    border-left: 3px solid var(--forest-primary);
    padding: 0.35rem 0.65rem;
    border-radius: 0 var(--radius-xs) var(--radius-xs) 0;
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    max-width: fit-content;
  }

  .suitability-kicker {
    font-weight: 700;
    color: var(--forest-primary);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .suitability-val {
    color: var(--navy-secondary);
    font-weight: 500;
  }

  /* Editorial Rationale */
  .row-editorial-rationale {
    font-size: 0.90625rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0 0 0.85rem 0;
    max-width: 72ch;
  }

  /* Key Differentiators (Bullet items) */
  .row-differentiators-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .differentiator-item {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.8125rem;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .diff-icon {
    flex-shrink: 0;
    color: var(--forest-primary);
    margin-top: 0.1rem;
  }

  /* Facts Strip */
  .row-facts-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8125rem;
  }

  .fact-col {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .fact-lbl {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .fact-score {
    font-weight: 700;
    color: var(--brass-accent);
  }

  .fact-source {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .fact-rate {
    font-family: var(--font-sans);
    font-weight: 700;
    color: var(--navy-primary);
  }

  .fact-cycle {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .fact-commute {
    color: var(--navy-secondary);
    font-weight: 500;
  }

  /* 3. Right Supporting Visual & Action Column */
  .row-visual-action {
    background-color: var(--bg-subtle);
    border-left: 1px solid var(--border-neutral);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }

  @media (max-width: 899px) {
    .row-visual-action {
      border-left: none;
      border-top: 1px solid var(--border-neutral);
      flex-direction: row;
      align-items: center;
    }
  }

  @media (max-width: 640px) {
    .row-visual-action {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .row-thumbnail-link {
    display: block;
    border-radius: var(--radius-xs);
    overflow: hidden;
    background-color: var(--bg-image-fallback);
    aspect-ratio: 16 / 10;
  }

  .row-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .row-ranking-row:hover .row-thumbnail {
    transform: scale(1.03);
  }

  @media (max-width: 899px) and (min-width: 641px) {
    .row-thumbnail-link {
      width: 180px;
      flex-shrink: 0;
    }
  }

  .row-action-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  @media (max-width: 899px) and (min-width: 641px) {
    .row-action-block {
      flex-grow: 1;
    }
  }

  .row-cta-btn {
    width: 100%;
    justify-content: center;
    font-size: 0.8125rem;
    padding: 0.55rem 0.85rem;
  }

  .action-subtext {
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-align: center;
  }
</style>

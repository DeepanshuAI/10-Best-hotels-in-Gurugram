---
import type { HotelRecord, HotelCategory } from '../data/types';
import { formatINR } from '../lib/site-config';
import RatingBadge from './RatingBadge.astro';

interface Props {
  hotel: HotelRecord;
  featured?: boolean;
}

const { hotel, featured = false } = Astro.props;

const categoryLabelMap: Record<HotelCategory, string> = {
  luxury: '5-Star Luxury',
  business: 'Corporate Business',
  budget: 'Smart Budget',
  resort: 'Luxury Resort',
  boutique: 'Boutique Stay',
};
---

<article 
  class:list={['hotel-card card', { 'hotel-card-featured': featured }]} 
  data-hotel-id={hotel.id}
  data-category={hotel.category}
  data-district={hotel.primaryDistrict}
  data-districts={hotel.districts.join(',')}
  data-price={hotel.indicativeStartingRateINR}
  data-score={hotel.ratingBenchmark.score}
  data-name={hotel.officialName.toLowerCase()}
>
  <div class="card-image-wrap">
    <img
      src={hotel.heroImage.src}
      alt={hotel.heroImage.alt}
      width="400"
      height="225"
      loading="lazy"
      decoding="async"
      class="card-image"
    />
    <div class="card-badges-top">
      <span class:list={['badge', hotel.category === 'luxury' || hotel.category === 'resort' ? 'badge-gold' : 'badge-emerald']}>
        {categoryLabelMap[hotel.category] || hotel.category}
      </span>
      <span class="badge badge-neutral price-tier-badge">{hotel.priceTier}</span>
    </div>
  </div>

  <div class="card-body">
    <div class="card-header">
      <div class="card-location">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span>{hotel.address.locality}</span>
      </div>
      <h3 class="card-title">
        <a href={`/hotels/${hotel.slug}/`} class="card-title-link">
          {hotel.officialName}
        </a>
      </h3>
    </div>

    <!-- Rating Benchmark -->
    <div class="card-rating">
      <RatingBadge benchmark={hotel.ratingBenchmark} size="sm" />
    </div>

    <p class="card-summary">{hotel.summary}</p>

    <!-- Transit Quick Tag -->
    <div class="card-transit-snippet">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="2" y="5" width="20" height="14" rx="2"/>
        <line x1="2" y1="10" x2="22" y2="10"/>
      </svg>
      <span><strong>Transit:</strong> {hotel.transit.walkingTimeToMetroMin} min to {hotel.transit.nearestMetroStation.split(' ')[0]} Metro &bull; {hotel.transit.driveTimeToCyberCityMin} min drive to Cyber City</span>
    </div>

    <!-- Best For Pill -->
    {hotel.bestFor && hotel.bestFor.length > 0 && (
      <div class="card-best-for">
        <span class="best-for-label">Best for:</span>
        <span class="best-for-value">{hotel.bestFor[0]}</span>
      </div>
    )}

    <!-- Top Verified Amenities -->
    <div class="card-amenities" aria-label="Key amenities">
      {hotel.verifiedAmenities.slice(0, 3).map((amenity: string) => (
        <span class="amenity-chip">{amenity}</span>
      ))}
    </div>

    <!-- Card Footer: Rate & Actions -->
    <div class="card-footer">
      <div class="card-pricing">
        <span class="rate-label">Indicative starting rate:</span>
        <div class="rate-value-wrap">
          <span class="rate-amount">{formatINR(hotel.indicativeStartingRateINR)}</span>
          <span class="rate-period">/ night</span>
        </div>
        <span class="rate-date">Verified {hotel.rateVerificationDate}</span>
      </div>

      <div class="card-actions">
        <a href={`/hotels/${hotel.slug}/`} class="btn btn-primary btn-sm">
          View Profile
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .hotel-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    background-color: var(--bg-card);
  }

  .card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #0F172A;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .hotel-card:hover .card-image {
    transform: scale(1.02);
  }

  .card-badges-top {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }

  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1 0 auto;
  }

  .card-header {
    margin-bottom: 0.5rem;
  }

  .card-location {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--emerald-primary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.25rem;
  }

  .card-title {
    font-size: 1.25rem;
    line-height: 1.3;
    margin-bottom: 0;
  }

  .card-title-link {
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .card-title-link:hover {
    color: var(--emerald-primary);
  }

  .card-rating {
    margin-bottom: 0.75rem;
  }

  .card-summary {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin-bottom: 0.875rem;
    flex: 1 0 auto;
  }

  .card-transit-snippet {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    background-color: var(--bg-subtle);
    padding: 0.5rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .card-transit-snippet svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--text-secondary);
  }

  .card-best-for {
    font-size: 0.75rem;
    background-color: var(--emerald-light);
    border: 1px solid var(--emerald-border);
    color: var(--emerald-hover);
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .best-for-label {
    font-weight: 700;
    margin-right: 0.25rem;
  }

  .card-amenities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1.25rem;
  }

  .amenity-chip {
    font-size: 0.6875rem;
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
  }

  .card-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  .card-pricing {
    display: flex;
    flex-direction: column;
  }

  .rate-label {
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .rate-value-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .rate-amount {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .rate-period {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .rate-date {
    font-size: 0.6875rem;
    color: var(--text-muted);
  }
</style>

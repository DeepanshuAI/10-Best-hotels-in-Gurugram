---
interface Props {
  activePath?: string;
}

const { activePath = Astro.url.pathname } = Astro.props;

const categoryDropdown = [
  { label: '5-Star Luxury Hotels', href: '/luxury-hotels-in-gurugram/' },
  { label: 'Corporate Business Hotels', href: '/business-hotels-in-gurugram/' },
  { label: 'Smart Budget Stays', href: '/budget-hotels-in-gurugram/' },
];

const areaDropdown = [
  { label: 'DLF Cyber City', href: '/hotels-near-cyber-city/' },
  { label: 'Golf Course Road', href: '/hotels-near-golf-course-road/' },
  { label: 'Udyog Vihar Phase IV–V', href: '/hotels-near-udyog-vihar/' },
  { label: 'MG Road & Sector 29', href: '/hotels-near-mg-road-gurugram/' },
  { label: 'Sohna Road Corridor', href: '/hotels-near-sohna-road/' },
];
---

<header class="site-header" role="banner">
  <div class="container header-container">
    <!-- Brand Identity -->
    <a href="/" class="brand-link" aria-label="Best Hotels in Gurugram - Editorial Rankings Directory">
      <div class="brand-monogram" aria-hidden="true">
        <span class="monogram-rank">#</span>
        <span class="monogram-letter">G</span>
      </div>
      <div class="brand-meta">
        <span class="brand-name">BEST HOTELS IN GURUGRAM</span>
        <span class="brand-tagline">Editorial Rankings & Directory</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul class="nav-list" role="list">
        <!-- 1. Rankings -->
        <li class="nav-item">
          <a
            href="/"
            class:list={['nav-link', { 'nav-link-active': activePath === '/' }]}
            aria-current={activePath === '/' ? 'page' : undefined}
          >
            Rankings
          </a>
        </li>

        <!-- 2. Compare Hotels -->
        <li class="nav-item">
          <a
            href="/compare/"
            class:list={['nav-link', { 'nav-link-active': activePath.startsWith('/compare') }]}
            aria-current={activePath.startsWith('/compare') ? 'page' : undefined}
          >
            Compare Hotels
          </a>
        </li>

        <!-- 3. By Category Dropdown -->
        <li class="nav-item nav-has-dropdown">
          <button
            type="button"
            class:list={['nav-link nav-dropdown-btn', { 'nav-link-active': activePath.includes('-hotels-in-gurugram') }]}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>By Category</span>
            <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="nav-dropdown-menu" role="menu">
            {categoryDropdown.map((cat) => (
              <a
                href={cat.href}
                class:list={['dropdown-link', { 'dropdown-link-active': activePath === cat.href }]}
                role="menuitem"
              >
                {cat.label}
              </a>
            ))}
          </div>
        </li>

        <!-- 4. By Area Dropdown -->
        <li class="nav-item nav-has-dropdown">
          <button
            type="button"
            class:list={['nav-link nav-dropdown-btn', { 'nav-link-active': activePath.startsWith('/hotels-near-') }]}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>By Area</span>
            <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="nav-dropdown-menu" role="menu">
            {areaDropdown.map((area) => (
              <a
                href={area.href}
                class:list={['dropdown-link', { 'dropdown-link-active': activePath === area.href }]}
                role="menuitem"
              >
                {area.label}
              </a>
            ))}
          </div>
        </li>

        <!-- 5. Guides -->
        <li class="nav-item">
          <a
            href="/guides/where-to-stay-in-gurugram/"
            class:list={['nav-link', { 'nav-link-active': activePath.startsWith('/guides') }]}
            aria-current={activePath.startsWith('/guides') ? 'page' : undefined}
          >
            Guides
          </a>
        </li>

        <!-- 6. Methodology -->
        <li class="nav-item">
          <a
            href="/how-we-choose-hotels/"
            class:list={['nav-link', { 'nav-link-active': activePath.startsWith('/how-we-choose-hotels') }]}
            aria-current={activePath.startsWith('/how-we-choose-hotels') ? 'page' : undefined}
          >
            Methodology
          </a>
        </li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="/compare/" class="btn btn-outline btn-sm compare-quick-cta">
        Compare 18 Hotels
      </a>

      <!-- Accessible Mobile Toggle -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="hamburger-icon" aria-hidden="true">
          <span class="line line-1"></span>
          <span class="line line-2"></span>
          <span class="line line-3"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-nav-drawer" class="mobile-drawer" hidden>
    <div class="container mobile-drawer-inner">
      <nav aria-label="Mobile Navigation">
        <div class="mobile-section">
          <span class="mobile-section-title">Directory Navigation</span>
          <ul class="mobile-links" role="list">
            <li><a href="/" class:list={['mobile-nav-link', { 'mobile-link-active': activePath === '/' }]}>Hotel Rankings (1–18)</a></li>
            <li><a href="/compare/" class:list={['mobile-nav-link', { 'mobile-link-active': activePath.startsWith('/compare') }]}>Compare Hotels Matrix</a></li>
            <li><a href="/guides/where-to-stay-in-gurugram/" class="mobile-nav-link">Editorial Guides</a></li>
            <li><a href="/how-we-choose-hotels/" class="mobile-nav-link">Ranking Methodology</a></li>
          </ul>
        </div>

        <div class="mobile-section">
          <span class="mobile-section-title">Rankings by Stay Tier</span>
          <ul class="mobile-links" role="list">
            {categoryDropdown.map((c) => (
              <li>
                <a href={c.href} class:list={['mobile-nav-link', { 'mobile-link-active': activePath === c.href }]}>
                  {c.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="mobile-section">
          <span class="mobile-section-title">Rankings by Business Corridor</span>
          <ul class="mobile-links" role="list">
            {areaDropdown.map((a) => (
              <li>
                <a href={a.href} class:list={['mobile-nav-link', { 'mobile-link-active': activePath === a.href }]}>
                  {a.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="mobile-section">
          <span class="mobile-section-title">Editorial Standards</span>
          <ul class="mobile-links" role="list">
            <li><a href="/how-we-choose-hotels/" class="mobile-nav-link">Selection Methodology</a></li>
            <li><a href="/editorial-policy/" class="mobile-nav-link">Editorial Policy</a></li>
            <li><a href="/corrections/" class="mobile-nav-link">Report a Discrepancy</a></li>
            <li><a href="/about/" class="mobile-nav-link">About This Directory</a></li>
          </ul>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-neutral);
    box-shadow: var(--shadow-sm);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 1.5rem;
  }

  /* Brand Link */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--navy-primary);
    flex-shrink: 0;
  }

  .brand-monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: var(--forest-primary);
    color: #FFFFFF;
    border-radius: var(--radius-xs);
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 1;
    font-family: var(--font-serif);
  }

  .monogram-rank {
    font-size: 0.8rem;
    opacity: 0.8;
    margin-right: 1px;
  }

  .brand-meta {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--navy-primary);
    line-height: 1.2;
  }

  .brand-tagline {
    font-size: 0.6875rem;
    color: var(--text-muted);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 960px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.5rem 0.25rem;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
    cursor: pointer;
  }

  .nav-link:hover,
  .nav-dropdown-btn:hover {
    color: var(--navy-primary);
    border-bottom-color: var(--forest-primary);
  }

  .nav-link-active {
    color: var(--navy-primary);
    font-weight: 700;
    border-bottom-color: var(--forest-primary);
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
  }

  /* Dropdown Menu */
  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 210px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-neutral);
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-hover);
    padding: 0.5rem 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
    z-index: 1000;
  }

  .nav-has-dropdown:hover .nav-dropdown-menu,
  .nav-has-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-has-dropdown:hover .dropdown-chevron,
  .nav-has-dropdown:focus-within .dropdown-chevron {
    transform: rotate(180deg);
  }

  .dropdown-link {
    display: block;
    padding: 0.55rem 1rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .dropdown-link:hover {
    background-color: var(--bg-subtle);
    color: var(--navy-primary);
  }

  .dropdown-link-active {
    color: var(--forest-primary);
    font-weight: 700;
    background-color: var(--forest-soft);
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .compare-quick-cta {
    display: none;
    font-size: 0.75rem;
    padding: 0.4rem 0.75rem;
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .compare-quick-cta {
      display: inline-flex;
    }
  }

  /* Mobile Toggle */
  .mobile-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border-neutral);
    border-radius: var(--radius-xs);
    background-color: transparent;
    cursor: pointer;
    color: var(--navy-primary);
    padding: 0;
  }

  @media (min-width: 960px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .hamburger-icon {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 18px;
    height: 14px;
  }

  .hamburger-icon .line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-menu-btn[aria-expanded="true"] .line-1 {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-menu-btn[aria-expanded="true"] .line-2 {
    opacity: 0;
  }

  .mobile-menu-btn[aria-expanded="true"] .line-3 {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-neutral);
    overflow-y: auto;
    padding: 1.5rem 0 3rem;
    z-index: 99;
  }

  .mobile-drawer[hidden] {
    display: none;
  }

  .mobile-section {
    margin-bottom: 2rem;
  }

  .mobile-section-title {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .mobile-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.5rem 0.25rem;
    font-size: 1rem;
    color: var(--navy-secondary);
    text-decoration: none;
    font-weight: 500;
  }

  .mobile-nav-link:hover,
  .mobile-link-active {
    color: var(--forest-primary);
    font-weight: 700;
  }
</style>

<script>
  function setupHeader() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');

    if (!toggleBtn || !drawer) return;

    const btn = toggleBtn;
    const menuDrawer = drawer;

    function openDrawer() {
      btn.setAttribute('aria-expanded', 'true');
      menuDrawer.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      btn.setAttribute('aria-expanded', 'false');
      menuDrawer.hidden = true;
      document.body.style.overflow = '';
    }

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menuDrawer.hidden) {
        closeDrawer();
        btn.focus();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 960 && !menuDrawer.hidden) {
        closeDrawer();
      }
    });
  }

  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>

---
import type { HotelRecord, HotelCategory, GurugramDistrict } from '../data/types';
import HotelCard from './HotelCard.astro';

interface Props {
  hotels: HotelRecord[];
  initialCategory?: HotelCategory;
  initialDistrict?: GurugramDistrict;
  title?: string;
}

const { hotels, initialCategory, initialDistrict } = Astro.props;

const categories = [
  { value: 'all', label: 'All Stay Categories' },
  { value: 'luxury', label: '5-Star Luxury' },
  { value: 'business', label: 'Corporate Business' },
  { value: 'budget', label: 'Smart Budget' },
  { value: 'resort', label: 'Resorts & Retreats' },
];

const districts = [
  { value: 'all', label: 'All Business Corridors' },
  { value: 'DLF Cyber City', label: 'DLF Cyber City' },
  { value: 'Golf Course Road', label: 'Golf Course Road' },
  { value: 'Udyog Vihar', label: 'Udyog Vihar' },
  { value: 'MG Road', label: 'MG Road & Sector 29' },
  { value: 'Sohna Road', label: 'Sohna Road' },
];
---

<section class="hotel-directory" id="rankings" aria-labelledby="directory-heading">
  <!-- Discovery & Filter Console -->
  <div class="directory-filter-console card">
    <div class="console-primary-row">
      <div class="search-field">
        <label for="hotel-search-input" class="visually-hidden">Search hotels by name, locality, or metro</label>
        <div class="search-input-wrapper">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            type="search"
            id="hotel-search-input"
            class="directory-search-input"
            placeholder="Search by hotel name, corridor (Cyber City, Golf Course Rd), metro station..."
            autocomplete="off"
          />
          <button type="button" id="search-clear-btn" class="search-clear-btn" aria-label="Clear search input" hidden>
            &times;
          </button>
        </div>
      </div>

      <button type="button" id="clear-all-filters-btn" class="btn btn-outline btn-sm reset-filters-btn">
        Reset Filters
      </button>
    </div>

    <!-- Filter Dropdowns Row -->
    <div class="console-filters-row">
      <div class="filter-col">
        <label for="filter-category" class="filter-label">Stay Category</label>
        <select id="filter-category" class="filter-select">
          {categories.map((c) => (
            <option value={c.value} selected={initialCategory === c.value}>
              {c.label}
            </option>
          ))}
        </select>
      </div>

      <div class="filter-col">
        <label for="filter-district" class="filter-label">Business Corridor</label>
        <select id="filter-district" class="filter-select">
          {districts.map((d) => (
            <option value={d.value} selected={initialDistrict === d.value}>
              {d.label}
            </option>
          ))}
        </select>
      </div>

      <div class="filter-col">
        <label for="filter-sort" class="filter-label">Sort Order</label>
        <select id="filter-sort" class="filter-select">
          <option value="recommended">Editorial Rank (Default #1–#18)</option>
          <option value="price-asc">Tariff: Low to High</option>
          <option value="price-desc">Tariff: High to Low</option>
          <option value="rating">Public Rating Score</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Live Results Counter & Editorial Assurance -->
  <div class="directory-status-strip">
    <div class="results-count">
      Showing <strong id="visible-count">{hotels.length}</strong> of {hotels.length} Ranked Properties
    </div>
    <div class="directory-guarantee">
      <span class="guarantee-indicator" aria-hidden="true"></span>
      <span>Ranked by verified transit, corporate facilities & corroborated reputation</span>
    </div>
  </div>

  <!-- Hotel Ranked List (Vertical Editorial Rows) -->
  <div id="hotel-grid" class="hotel-grid" role="feed" aria-label="Ranked Hotel Directory">
    {hotels.map((hotel: HotelRecord, index: number) => (
      <div class="hotel-grid-item" data-hotel-card-item>
        <HotelCard hotel={hotel} rank={index + 1} />
      </div>
    ))}
  </div>

  <!-- Empty State -->
  <div id="directory-empty-state" class="directory-empty-state card" hidden>
    <div class="empty-icon" aria-hidden="true">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="10"/>
        <line x1="8" y1="12" x2="16" y2="12"/>
      </svg>
    </div>
    <h3 class="empty-heading font-serif">No ranked hotels match your criteria</h3>
    <p class="empty-sub">Try modifying your keyword search or setting the corridor to "All Business Corridors" to view full inventory.</p>
    <button type="button" id="empty-state-reset-btn" class="btn btn-primary btn-sm">
      Show All Properties
    </button>
  </div>
</section>

<style>
  .hotel-directory {
    margin-top: 1.5rem;
    margin-bottom: 4rem;
  }

  .directory-filter-console {
    padding: 1.25rem 1.5rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-neutral);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    margin-bottom: 1rem;
  }

  .console-primary-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .console-primary-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .search-field {
    flex-grow: 1;
    position: relative;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.85rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  .directory-search-input {
    width: 100%;
    padding: 0.7rem 2.2rem 0.7rem 2.5rem;
    font-size: 0.9375rem;
    font-family: var(--font-sans);
    background-color: var(--bg-primary);
    border: 1px solid var(--border-neutral);
    border-radius: var(--radius-xs);
    color: var(--navy-primary);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .directory-search-input:focus {
    outline: none;
    border-color: var(--forest-primary);
    box-shadow: 0 0 0 3px rgba(20, 83, 45, 0.12);
  }

  .search-clear-btn {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.2rem;
  }

  .search-clear-btn:hover {
    color: var(--navy-primary);
  }

  .reset-filters-btn {
    font-size: 0.8125rem;
    padding: 0.6rem 1rem;
    white-space: nowrap;
  }

  /* Filters Row */
  .console-filters-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
  }

  @media (min-width: 640px) {
    .console-filters-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .filter-col {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .filter-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .filter-select {
    width: 100%;
    padding: 0.55rem 0.75rem;
    font-size: 0.875rem;
    font-family: var(--font-sans);
    background-color: var(--bg-primary);
    border: 1px solid var(--border-neutral);
    border-radius: var(--radius-xs);
    color: var(--navy-primary);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .filter-select:focus {
    outline: none;
    border-color: var(--forest-primary);
  }

  /* Status Strip */
  .directory-status-strip {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
    padding: 0.5rem 0.25rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  @media (min-width: 640px) {
    .directory-status-strip {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .results-count strong {
    color: var(--navy-primary);
  }

  .directory-guarantee {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--forest-primary);
    font-weight: 600;
  }

  .guarantee-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--forest-primary);
    display: inline-block;
  }

  /* Hotel Vertical Ranked Rows */
  .hotel-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hotel-grid-item[hidden] {
    display: none !important;
  }

  /* Empty State */
  .directory-empty-state {
    padding: 3.5rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
    background-color: var(--bg-surface);
  }

  .empty-icon {
    color: var(--text-muted);
  }

  .empty-heading {
    font-size: 1.4rem;
    margin-bottom: 0;
    color: var(--navy-primary);
  }

  .empty-sub {
    color: var(--text-muted);
    max-width: 480px;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
  }
</style>

<script>
  function setupHotelDirectory() {
    const searchInput = document.getElementById('hotel-search-input') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('search-clear-btn');
    const categorySelect = document.getElementById('filter-category') as HTMLSelectElement | null;
    const districtSelect = document.getElementById('filter-district') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement | null;
    const clearAllBtn = document.getElementById('clear-all-filters-btn');
    const emptyStateResetBtn = document.getElementById('empty-state-reset-btn');
    const visibleCountEl = document.getElementById('visible-count');
    const emptyState = document.getElementById('directory-empty-state');
    const grid = document.getElementById('hotel-grid');

    if (!grid) return;

    const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-hotel-card-item]'));

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      const selectedCategory = categorySelect?.value || 'all';
      const selectedDistrict = districtSelect?.value || 'all';
      const selectedSort = sortSelect?.value || 'recommended';

      if (clearSearchBtn) {
        clearSearchBtn.hidden = query.length === 0;
      }

      let visibleCount = 0;

      // Filter
      items.forEach((item) => {
        const article = item.querySelector<HTMLElement>('article');
        if (!article) return;

        const name = (article.dataset.name || '').toLowerCase();
        const category = article.dataset.category || '';
        const districts = (article.dataset.districts || '').toLowerCase();
        const primaryDistrict = article.dataset.district || '';

        const matchesQuery = query === '' || 
          name.includes(query) || 
          districts.includes(query) ||
          article.textContent?.toLowerCase().includes(query);

        const matchesCategory = selectedCategory === 'all' || category === selectedCategory;
        const matchesDistrict = selectedDistrict === 'all' || 
          primaryDistrict === selectedDistrict || 
          districts.includes(selectedDistrict.toLowerCase());

        const isVisible = matchesQuery && matchesCategory && matchesDistrict;

        if (isVisible) {
          item.hidden = false;
          visibleCount++;
        } else {
          item.hidden = true;
        }
      });

      // Sort items
      const sortedItems = [...items].sort((a, b) => {
        const articleA = a.querySelector<HTMLElement>('article');
        const articleB = b.querySelector<HTMLElement>('article');
        if (!articleA || !articleB) return 0;

        if (selectedSort === 'price-asc') {
          return Number(articleA.dataset.price || 0) - Number(articleB.dataset.price || 0);
        }
        if (selectedSort === 'price-desc') {
          return Number(articleB.dataset.price || 0) - Number(articleA.dataset.price || 0);
        }
        if (selectedSort === 'rating') {
          return Number(articleB.dataset.score || 0) - Number(articleA.dataset.score || 0);
        }
        // Default: Recommended rank order (1 to 18)
        return Number(articleA.dataset.rank || 0) - Number(articleB.dataset.rank || 0);
      });

      // Re-append sorted elements
      if (grid) {
        sortedItems.forEach((item) => grid.appendChild(item));
      }

      // Update count & empty state
      if (visibleCountEl) {
        visibleCountEl.textContent = String(visibleCount);
      }

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
    }

    // Events
    searchInput?.addEventListener('input', applyFilters);
    categorySelect?.addEventListener('change', applyFilters);
    districtSelect?.addEventListener('change', applyFilters);
    sortSelect?.addEventListener('change', applyFilters);

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      applyFilters();
      searchInput?.focus();
    });

    function resetAll() {
      if (searchInput) searchInput.value = '';
      if (categorySelect) categorySelect.value = 'all';
      if (districtSelect) districtSelect.value = 'all';
      if (sortSelect) sortSelect.value = 'recommended';
      applyFilters();
    }

    clearAllBtn?.addEventListener('click', resetAll);
    emptyStateResetBtn?.addEventListener('click', resetAll);

    // Initial run
    applyFilters();
  }

  setupHotelDirectory();
  document.addEventListener('astro:after-swap', setupHotelDirectory);
</script>

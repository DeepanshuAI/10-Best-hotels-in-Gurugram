---
import type { HotelRecord, HotelCategory, GurugramDistrict } from '../data/types';
import HotelCard from './HotelCard.astro';

interface Props {
  hotels: HotelRecord[];
  initialCategory?: HotelCategory;
  initialDistrict?: GurugramDistrict;
  title?: string;
}

const { hotels, initialCategory, initialDistrict } = Astro.props;

const categories = [
  { value: 'all', label: 'All Categories' },
  { value: 'luxury', label: '5-Star Luxury' },
  { value: 'business', label: 'Corporate Business' },
  { value: 'budget', label: 'Smart Budget' },
  { value: 'resort', label: 'Luxury Resort' },
];

const districts = [
  { value: 'all', label: 'All Business Districts' },
  { value: 'DLF Cyber City', label: 'DLF Cyber City' },
  { value: 'Golf Course Road', label: 'Golf Course Road' },
  { value: 'Udyog Vihar', label: 'Udyog Vihar' },
  { value: 'MG Road', label: 'MG Road & Sector 29' },
  { value: 'Sohna Road', label: 'Sohna Road' },
];
---

<section class="hotel-directory" id="directory" aria-labelledby="directory-heading">
  <!-- Controls Bar -->
  <div class="directory-controls card">
    <div class="controls-top">
      <div class="search-box">
        <label for="hotel-search-input" class="visually-hidden">Search hotels by name, locality, or landmark</label>
        <div class="search-input-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            type="search"
            id="hotel-search-input"
            class="search-input"
            placeholder="Search by hotel name, Cyber City, metro station..."
            autocomplete="off"
          />
          <button type="button" id="search-clear-btn" class="search-clear-btn" aria-label="Clear search text" hidden>
            &times;
          </button>
        </div>
      </div>

      <!-- Quick Reset Button -->
      <button type="button" id="clear-all-filters-btn" class="btn btn-outline btn-sm clear-filters-btn">
        Reset All
      </button>
    </div>

    <div class="controls-filters">
      <!-- Category Filter -->
      <div class="filter-group">
        <label for="filter-category" class="filter-label">Stay Category:</label>
        <select id="filter-category" class="filter-select">
          {categories.map((c) => (
            <option value={c.value} selected={initialCategory === c.value}>
              {c.label}
            </option>
          ))}
        </select>
      </div>

      <!-- District Filter -->
      <div class="filter-group">
        <label for="filter-district" class="filter-label">Location / Zone:</label>
        <select id="filter-district" class="filter-select">
          {districts.map((d) => (
            <option value={d.value} selected={initialDistrict === d.value}>
              {d.label}
            </option>
          ))}
        </select>
      </div>

      <!-- Sort Filter -->
      <div class="filter-group">
        <label for="filter-sort" class="filter-label">Sort By:</label>
        <select id="filter-sort" class="filter-select">
          <option value="recommended">Editorial Recommendation</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
          <option value="rating">Public Rating Benchmark</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Live Counter Bar -->
  <div class="directory-status-bar">
    <div class="status-counter">
      Showing <span id="visible-count" class="counter-highlight">{hotels.length}</span> of {hotels.length} verified Gurugram properties
    </div>
    <div class="status-note">
      <span class="audit-dot" aria-hidden="true"></span>
      100% Verified Profiles &bull; Zero Paid Placements
    </div>
  </div>

  <!-- Hotel Grid (Pre-rendered for complete SEO crawlability) -->
  <div id="hotel-grid" class="hotel-grid">
    {hotels.map((hotel: HotelRecord) => (
      <div class="hotel-grid-item" data-hotel-card-item>
        <HotelCard hotel={hotel} />
      </div>
    ))}
  </div>

  <!-- Empty State (Hidden by default) -->
  <div id="directory-empty-state" class="directory-empty-state card" hidden>
    <div class="empty-icon" aria-hidden="true">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="10"/>
        <line x1="8" y1="12" x2="16" y2="12"/>
      </svg>
    </div>
    <h3>No verified hotels match your search criteria</h3>
    <p>Try clearing your search query or selecting "All Business Districts" to view full Gurugram inventory.</p>
    <button type="button" id="empty-state-reset-btn" class="btn btn-primary btn-sm">
      Reset All Filters
    </button>
  </div>
</section>

<style>
  .hotel-directory {
    margin-top: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .directory-controls {
    padding: 1.25rem;
    margin-bottom: 1.5rem;
    background-color: var(--bg-card);
  }

  .controls-top {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .controls-top {
      flex-direction: row;
      align-items: center;
    }
  }

  .search-box {
    flex: 1 1 auto;
  }

  .search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.875rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 2.25rem 0.75rem 2.5rem;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-size: 0.9375rem;
    transition: all var(--transition-fast);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--emerald-primary);
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    background-color: var(--bg-card);
  }

  .search-clear-btn {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    font-size: 1.25rem;
    color: var(--text-muted);
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem;
  }

  .clear-filters-btn {
    flex-shrink: 0;
  }

  .controls-filters {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  @media (min-width: 640px) {
    .controls-filters {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .filter-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .filter-select {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    background-color: var(--bg-card);
    color: var(--text-primary);
    font-size: 0.875rem;
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }

  .filter-select:focus {
    outline: none;
    border-color: var(--emerald-primary);
  }

  .directory-status-bar {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: space-between;
    align-items: flex-start;
    padding: 0.5rem 0.25rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  @media (min-width: 640px) {
    .directory-status-bar {
      flex-direction: row;
      align-items: center;
    }
  }

  .counter-highlight {
    font-weight: 700;
    color: var(--emerald-primary);
  }

  .status-note {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .audit-dot {
    width: 8px;
    height: 8px;
    background-color: var(--emerald-primary);
    border-radius: 50%;
  }

  .hotel-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .hotel-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .hotel-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hotel-grid-item[hidden] {
    display: none !important;
  }

  /* Empty State */
  .directory-empty-state {
    padding: 3.5rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .empty-icon {
    color: var(--text-muted);
  }

  .directory-empty-state h3 {
    margin-bottom: 0;
    font-size: 1.25rem;
  }

  .directory-empty-state p {
    color: var(--text-muted);
    max-width: 450px;
    margin-bottom: 0.5rem;
  }
</style>

<script>
  function setupHotelDirectory() {
    const searchInput = document.getElementById('hotel-search-input') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('search-clear-btn');
    const categorySelect = document.getElementById('filter-category') as HTMLSelectElement | null;
    const districtSelect = document.getElementById('filter-district') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement | null;
    const clearAllBtn = document.getElementById('clear-all-filters-btn');
    const emptyStateResetBtn = document.getElementById('empty-state-reset-btn');
    const visibleCountEl = document.getElementById('visible-count');
    const emptyState = document.getElementById('directory-empty-state');
    const grid = document.getElementById('hotel-grid');

    if (!grid) return;

    const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-hotel-card-item]'));

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      const selectedCategory = categorySelect?.value || 'all';
      const selectedDistrict = districtSelect?.value || 'all';
      const selectedSort = sortSelect?.value || 'recommended';

      if (clearSearchBtn) {
        clearSearchBtn.hidden = query.length === 0;
      }

      let visibleCount = 0;

      // Filter
      items.forEach((item) => {
        const article = item.querySelector<HTMLElement>('article');
        if (!article) return;

        const name = (article.dataset.name || '').toLowerCase();
        const category = article.dataset.category || '';
        const districts = (article.dataset.districts || '').toLowerCase();
        const primaryDistrict = article.dataset.district || '';

        const matchesQuery = query === '' || 
          name.includes(query) || 
          districts.includes(query) ||
          article.textContent?.toLowerCase().includes(query);

        const matchesCategory = selectedCategory === 'all' || category === selectedCategory;
        const matchesDistrict = selectedDistrict === 'all' || 
          primaryDistrict === selectedDistrict || 
          districts.includes(selectedDistrict.toLowerCase());

        const isVisible = matchesQuery && matchesCategory && matchesDistrict;

        if (isVisible) {
          item.hidden = false;
          visibleCount++;
        } else {
          item.hidden = true;
        }
      });

      // Sort visible items
      const sortedItems = [...items].sort((a, b) => {
        const articleA = a.querySelector<HTMLElement>('article');
        const articleB = b.querySelector<HTMLElement>('article');
        if (!articleA || !articleB) return 0;

        if (selectedSort === 'price-asc') {
          return Number(articleA.dataset.price || 0) - Number(articleB.dataset.price || 0);
        }
        if (selectedSort === 'price-desc') {
          return Number(articleB.dataset.price || 0) - Number(articleA.dataset.price || 0);
        }
        if (selectedSort === 'rating') {
          return Number(articleB.dataset.score || 0) - Number(articleA.dataset.score || 0);
        }
        return 0; // Default: Recommended order
      });

      // Re-append sorted elements
      if (grid) {
        sortedItems.forEach((item) => grid.appendChild(item));
      }

      // Update count & empty state
      if (visibleCountEl) {
        visibleCountEl.textContent = String(visibleCount);
      }

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
    }

    // Events
    searchInput?.addEventListener('input', applyFilters);
    categorySelect?.addEventListener('change', applyFilters);
    districtSelect?.addEventListener('change', applyFilters);
    sortSelect?.addEventListener('change', applyFilters);

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      applyFilters();
      searchInput?.focus();
    });

    function resetAll() {
      if (searchInput) searchInput.value = '';
      if (categorySelect) categorySelect.value = 'all';
      if (districtSelect) districtSelect.value = 'all';
      if (sortSelect) sortSelect.value = 'recommended';
      applyFilters();
    }

    clearAllBtn?.addEventListener('click', resetAll);
    emptyStateResetBtn?.addEventListener('click', resetAll);

    // Initial run to reflect any pre-selected values
    applyFilters();
  }

  setupHotelDirectory();
  document.addEventListener('astro:after-swap', setupHotelDirectory);
</script>

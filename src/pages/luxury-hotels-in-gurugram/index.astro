---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import HotelCard from '../../components/HotelCard.astro';
import HotelComparisonTable from '../../components/HotelComparisonTable.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { HOTELS } from '../../data/hotels';
import { CATEGORY_HUBS } from '../../data/categories';
import { generateItemListSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../lib/seo';

const hub = CATEGORY_HUBS['luxury-hotels-in-gurugram'];
const luxuryHotels = HOTELS.filter((h) => h.category === 'luxury' || h.category === 'resort');

const breadcrumbs = [
  { label: 'Hotels', href: '/' },
  { label: hub.title, href: '/luxury-hotels-in-gurugram/' }
];

const itemListSchema = generateItemListSchema(hub.title, luxuryHotels, 'luxury-hotels-in-gurugram');
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: hub.title, url: '/luxury-hotels-in-gurugram/' },
]);
const faqSchema = generateFaqSchema(hub.faqItems);
---

<BaseLayout
  title={hub.metaTitle}
  description={hub.metaDescription}
  canonicalPath="/luxury-hotels-in-gurugram/"
  jsonLd={[itemListSchema, breadcrumbSchema, faqSchema]}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Editorial Category Masthead -->
  <header class="hub-hero">
    <div class="container hub-hero-container">
      <div class="hero-kicker-wrap">
        <span class="editorial-kicker">Curated Category Rankings</span>
        <span class="badge badge-brass">5-Star Luxury & Executive Sanctuaries</span>
      </div>
      <h1 class="hub-h1 font-serif">{hub.h1}</h1>
      <p class="lead hub-lead">{hub.heroLead}</p>
      
      <!-- Selection Criteria Summary -->
      <div class="category-criteria-box">
        <span class="criteria-header">Luxury Selection Standards:</span>
        <span>Standard rooms must exceed 450 sq ft &bull; Acoustic soundproof glazing against highway noise &bull; 24-hr serviced business centres &bull; Zero sponsored placement</span>
      </div>
    </div>
  </header>

  <!-- Side-by-Side Category Comparison Matrix -->
  <section class="container comparison-section">
    <div class="section-heading-row">
      <span class="editorial-kicker">Comparison Matrix</span>
      <h2 class="font-serif">Compare Luxury Properties Side-by-Side</h2>
      <p>Evaluate square footage, highway drive times, and verified benchmark ratings before reading full dossiers.</p>
    </div>

    <HotelComparisonTable hotels={luxuryHotels} id="luxury-comparison" />
  </section>

  <!-- Ranked Hotel List Section -->
  <section class="container rankings-section">
    <div class="section-heading-row">
      <span class="editorial-kicker">Editorial Rankings</span>
      <h2 class="font-serif">The Ranked 5-Star Luxury Hotels</h2>
      <p>Properties ordered by physical room specifications, acoustic tranquility, and corporate meeting facilities.</p>
    </div>

    <div class="hotel-ranked-list">
      {luxuryHotels.map((hotel, index) => (
        <HotelCard hotel={hotel} rank={index + 1} />
      ))}
    </div>
  </section>

  <!-- Editorial Buying Advice -->
  <section class="buying-advice-section">
    <div class="container advice-container">
      <div class="section-heading-row">
        <span class="editorial-kicker">Executive Intelligence</span>
        <h2 class="font-serif">Luxury Accommodation Advice for Gurugram</h2>
        <p>Strategic factors corporate leadership and conference planners should evaluate before reserving.</p>
      </div>

      <div class="advice-grid">
        {hub.buyingAdvice.map((item, idx) => (
          <div class="advice-card card">
            <span class="advice-number font-serif">0{idx + 1}</span>
            <h3 class="advice-title font-serif">{item.title}</h3>
            <p class="advice-body">{item.content}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Hub FAQs -->
  <FaqAccordion faqs={hub.faqItems} title={`Frequently Asked Questions About ${hub.title}`} />
</BaseLayout>

<style>
  .hub-hero {
    background-color: var(--bg-surface);
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--border-neutral);
  }

  .hub-hero-container {
    max-width: 920px;
    margin: 0 auto;
    text-align: left;
  }

  .hero-kicker-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .editorial-kicker {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--forest-primary);
  }

  .hub-h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1.15;
    color: var(--navy-primary);
    margin: 0.25rem 0 1rem 0;
  }

  .hub-lead {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    max-width: 76ch;
  }

  .category-criteria-box {
    padding: 0.85rem 1.25rem;
    background-color: var(--bg-subtle);
    border-left: 3px solid var(--forest-primary);
    border-radius: 0 var(--radius-xs) var(--radius-xs) 0;
    font-size: 0.8125rem;
    color: var(--navy-secondary);
    line-height: 1.5;
  }

  .criteria-header {
    font-weight: 700;
    color: var(--navy-primary);
    margin-right: 0.35rem;
  }

  /* Comparison Section */
  .comparison-section {
    padding-top: 3.5rem;
    padding-bottom: 1.5rem;
  }

  .section-heading-row {
    margin-bottom: 1.5rem;
  }

  .section-heading-row h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--navy-primary);
    margin: 0.25rem 0 0.5rem 0;
  }

  .section-heading-row p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
    max-width: 68ch;
  }

  /* Ranked List */
  .rankings-section {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .hotel-ranked-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Advice Section */
  .buying-advice-section {
    background-color: var(--bg-subtle);
    border-top: 1px solid var(--border-neutral);
    border-bottom: 1px solid var(--border-neutral);
    padding: 4rem 0;
  }

  .advice-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .advice-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .advice-card {
    padding: 1.75rem;
    background-color: var(--bg-surface);
  }

  .advice-number {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--forest-primary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .advice-title {
    font-size: 1.15rem;
    color: var(--navy-primary);
    margin: 0 0 0.5rem 0;
  }

  .advice-body {
    font-size: 0.84375rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0;
  }
</style>

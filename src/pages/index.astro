---
import BaseLayout from '../layouts/BaseLayout.astro';
import HotelDirectory from '../components/HotelDirectory.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { HOTELS } from '../data/hotels';
import { HOMEPAGE_FAQS } from '../data/faqs';
import { generateWebSiteSchema, generateItemListSchema } from '../lib/seo';

const title = 'Best Hotels in Gurugram (2026) | Verified Local Directory & Transit Guide';
const description = 'Independent, verified guide to the best hotels in Gurugram (Gurgaon). Compare luxury, business & budget stays across Cyber City, Golf Course Road, Udyog Vihar & MG Road.';

const webSiteSchema = generateWebSiteSchema();
const itemListSchema = generateItemListSchema('Best Hotels in Gurugram', HOTELS, '/');

const categoryCards = [
  {
    title: 'Luxury Stays',
    count: HOTELS.filter((h) => h.category === 'luxury' || h.category === 'resort').length,
    description: '5-star sanctuaries, golf retreats & executive lounges.',
    href: '/luxury-hotels-in-gurugram/',
    badge: '5-Star Hospitality',
  },
  {
    title: 'Business Hotels',
    count: HOTELS.filter((h) => h.category === 'business').length,
    description: 'Ergonomic desks, boardrooms & high-speed enterprise Wi-Fi.',
    href: '/business-hotels-in-gurugram/',
    badge: 'Corporate Focus',
  },
  {
    title: 'Smart Budget',
    count: HOTELS.filter((h) => h.category === 'budget').length,
    description: 'Standardized cleanliness, CloudBeds & sub-₹4,500 tariffs.',
    href: '/budget-hotels-in-gurugram/',
    badge: 'Verified Value',
  },
];

const locationShortcuts = [
  { name: 'DLF Cyber City', count: '4 properties', href: '/hotels-near-cyber-city/', tag: 'Fortune 500 Hub' },
  { name: 'Golf Course Road', count: '5 properties', href: '/hotels-near-golf-course-road/', tag: 'Rapid Metro Line' },
  { name: 'Udyog Vihar', count: '4 properties', href: '/hotels-near-udyog-vihar/', tag: 'Phase 1–5 Access' },
  { name: 'MG Road & Sec 29', count: '4 properties', href: '/hotels-near-mg-road-gurugram/', tag: 'Yellow Line Metro' },
  { name: 'Sohna Road', count: '2 properties', href: '/hotels-near-sohna-road/', tag: 'Suburban IT Parks' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  jsonLd={[webSiteSchema, itemListSchema]}
>
  <!-- Hero Section -->
  <section class="hero-section" aria-labelledby="hero-title">
    <div class="container hero-container">
      <div class="hero-badge-wrap">
        <span class="badge badge-emerald">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          100% Independent Local Directory &bull; Zero Paid Rankings
        </span>
      </div>

      <h1 id="hero-title" class="hero-title">
        The Best Hotels in Gurugram, <br class="hidden-mobile" />
        <span class="hero-title-accent">Curated with Transit Reality</span>
      </h1>

      <p class="lead hero-lead">
        Navigate Gurugram’s divided expressways with confidence. We independently audit physical amenities, noise levels, Rapid Metro walkability, and realistic commute times across <strong>DLF Cyber City</strong>, <strong>Golf Course Road</strong>, <strong>Udyog Vihar</strong>, and <strong>MG Road</strong>.
      </p>

      <!-- Quick Category Cards -->
      <div class="hero-categories-grid">
        {categoryCards.map((cat) => (
          <a href={cat.href} class="hero-cat-card card">
            <div class="cat-card-header">
              <span class="badge badge-emerald">{cat.badge}</span>
              <span class="cat-count">{cat.count} Hotels</span>
            </div>
            <h2 class="cat-card-title">{cat.title}</h2>
            <p class="cat-card-desc">{cat.description}</p>
            <div class="cat-card-arrow" aria-hidden="true">
              Explore {cat.title} &rarr;
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Location Shortcuts Bar -->
  <section class="locations-bar-section" aria-label="Corporate districts shortcuts">
    <div class="container">
      <div class="locations-bar card">
        <span class="locations-bar-label">Explore by Business Corridor:</span>
        <div class="locations-chip-list">
          {locationShortcuts.map((loc) => (
            <a href={loc.href} class="location-chip">
              <span class="loc-name">{loc.name}</span>
              <span class="loc-tag">{loc.tag}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Main Directory Section -->
  <section class="container directory-section" aria-labelledby="directory-main-heading">
    <div class="section-intro">
      <span class="badge badge-neutral">Interactive Directory</span>
      <h2 id="directory-main-heading">Compare Verified Gurugram Hotels</h2>
      <p>Filter by stay category, business district, indicative starting tariff, or search by landmark.</p>
    </div>

    <HotelDirectory hotels={HOTELS} />
  </section>

  <!-- Selection Methodology Feature Section -->
  <section class="methodology-feature-section section-padding" aria-labelledby="methodology-feature-heading">
    <div class="container methodology-feature-container">
      <div class="methodology-feature-card card">
        <div class="methodology-badge">
          <span class="badge badge-gold">Transparent Editorial Process</span>
        </div>
        <h2 id="methodology-feature-heading" class="methodology-feature-title">
          How We Audit & Select Hotels in Gurugram
        </h2>
        <p class="methodology-feature-lead">
          Unlike online booking portals that list thousands of unverified rooms with artificially inflated star ratings, this directory follows strict, non-commercial quality criteria:
        </p>

        <div class="methodology-pillars-grid">
          <div class="pillar-item">
            <div class="pillar-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <h3>1. The Gurugram U-Turn Audit</h3>
            <p>We reject straight-line distance claims. Every listing details real driving routes across NH-48 flyovers and confirms exact walkability to Yellow Line or Rapid Metro stations.</p>
          </div>

          <div class="pillar-item">
            <div class="pillar-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
              </svg>
            </div>
            <h3>2. Workstation Ergonomics</h3>
            <p>We verify dedicated in-room desk lighting, ergonomic chair support, soundproofing against expressway flyovers, and enterprise Wi-Fi stability for corporate travelers.</p>
          </div>

          <div class="pillar-item">
            <div class="pillar-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <h3>3. Zero Paid Placement</h3>
            <p>Hoteliers cannot purchase inclusion, higher rankings, or positive editorial characterizations. All listings are based strictly on corroborated physical facts and public consistency.</p>
          </div>
        </div>

        <div class="methodology-cta">
          <a href="/how-we-choose-hotels/" class="btn btn-outline">
            Read Full Selection Methodology &rarr;
          </a>
          <a href="/corrections/" class="btn btn-outline">
            Report a Factual Discrepancy
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Area Guide Preview Section -->
  <section class="guide-preview-section section-padding" aria-labelledby="guide-preview-heading">
    <div class="container">
      <div class="guide-preview-header">
        <span class="badge badge-emerald">Decision Support</span>
        <h2 id="guide-preview-heading">Essential Guides for Gurugram Visitors</h2>
        <p>In-depth, transit-aware resources designed to help you avoid common travel mistakes in NCR.</p>
      </div>

      <div class="guide-cards-grid">
        <article class="guide-card card">
          <div class="guide-card-body">
            <span class="guide-tag">Neighborhood Orientation</span>
            <h3 class="guide-title">
              <a href="/guides/where-to-stay-in-gurugram/">Where to Stay in Gurugram: Neighborhood & District Guide</a>
            </h3>
            <p class="guide-desc">
              Understand the real trade-offs between DLF Cyber City, Golf Course Road, MG Road, Udyog Vihar, and Sohna Road before booking.
            </p>
            <a href="/guides/where-to-stay-in-gurugram/" class="text-link guide-read-more">
              Read 8-Min Guide &rarr;
            </a>
          </div>
        </article>

        <article class="guide-card card">
          <div class="guide-card-body">
            <span class="guide-tag">Corporate Travel</span>
            <h3 class="guide-title">
              <a href="/guides/hotels-for-business-travel-in-gurugram/">Hotels for Business Travel in Gurugram: Practical Executive Guide</a>
            </h3>
            <p class="guide-desc">
              How to evaluate in-room desk ergonomics, soundproofing against highway roar, airport departure times, and Rapid Metro access.
            </p>
            <a href="/guides/hotels-for-business-travel-in-gurugram/" class="text-link guide-read-more">
              Read 7-Min Guide &rarr;
            </a>
          </div>
        </article>

        <article class="guide-card card">
          <div class="guide-card-body">
            <span class="guide-tag">Budget Due Diligence</span>
            <h3 class="guide-title">
              <a href="/guides/choosing-a-budget-hotel-in-gurugram/">Choosing a Budget Hotel in Gurugram: How to Avoid Bad Stays</a>
            </h3>
            <p class="guide-desc">
              How to bypass fake reviews and unbranded guest house traps by selecting vetted branded chains like Bloom, ibis, and Ginger.
            </p>
            <a href="/guides/choosing-a-budget-hotel-in-gurugram/" class="text-link guide-read-more">
              Read 6-Min Guide &rarr;
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Homepage FAQs -->
  <FaqAccordion faqs={HOMEPAGE_FAQS} title="Frequently Asked Questions About Staying in Gurugram" />
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    background: linear-gradient(180deg, #F0FDF4 0%, var(--bg-primary) 100%);
    padding-top: 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-container {
    text-align: center;
    max-width: 960px;
  }

  .hero-badge-wrap {
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: 2.375rem;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.25rem;
    }
  }

  .hero-title-accent {
    color: var(--emerald-primary);
  }

  .hero-lead {
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 2.5rem;
    color: var(--text-secondary);
  }

  .hidden-mobile {
    display: none;
  }

  @media (min-width: 768px) {
    .hidden-mobile {
      display: inline;
    }
  }

  /* Hero Categories Grid */
  .hero-categories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    text-align: left;
  }

  @media (min-width: 640px) {
    .hero-categories-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hero-cat-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    border-top: 4px solid var(--emerald-primary);
  }

  .cat-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .cat-count {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .cat-card-title {
    font-size: 1.25rem;
    margin-bottom: 0.375rem;
  }

  .cat-card-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    flex: 1 0 auto;
  }

  .cat-card-arrow {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--emerald-primary);
  }

  /* Locations Bar Section */
  .locations-bar-section {
    margin-top: -1rem;
    margin-bottom: 2rem;
  }

  .locations-bar {
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .locations-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .locations-bar-label {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .locations-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .location-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.35rem 0.75rem;
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    transition: all var(--transition-fast);
  }

  .location-chip:hover {
    border-color: var(--emerald-primary);
    background-color: var(--emerald-light);
    color: var(--emerald-hover);
  }

  .loc-name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .loc-tag {
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  /* Section Intro */
  .section-intro {
    text-align: center;
    max-width: 650px;
    margin: 2rem auto 1.5rem;
  }

  .section-intro .badge {
    margin-bottom: 0.5rem;
  }

  /* Methodology Feature */
  .methodology-feature-section {
    background-color: var(--bg-card);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .methodology-feature-card {
    padding: 2.5rem 1.5rem;
    border: 1px solid var(--border-subtle);
  }

  @media (min-width: 768px) {
    .methodology-feature-card {
      padding: 3.5rem 3rem;
    }
  }

  .methodology-badge {
    margin-bottom: 1rem;
  }

  .methodology-feature-title {
    font-size: 1.875rem;
    margin-bottom: 0.75rem;
  }

  .methodology-feature-lead {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 750px;
    margin-bottom: 2.5rem;
  }

  .methodology-pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .methodology-pillars-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pillar-item {
    display: flex;
    flex-direction: column;
  }

  .pillar-icon {
    width: 2.75rem;
    height: 2.75rem;
    background-color: var(--emerald-light);
    color: var(--emerald-primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    border: 1px solid var(--emerald-border);
  }

  .pillar-item h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .pillar-item p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .methodology-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  /* Guide Preview Section */
  .guide-preview-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 2.5rem;
  }

  .guide-preview-header .badge {
    margin-bottom: 0.5rem;
  }

  .guide-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .guide-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
  }

  .guide-card-body {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .guide-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--emerald-primary);
    margin-bottom: 0.5rem;
  }

  .guide-title {
    font-size: 1.125rem;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .guide-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex: 1 0 auto;
  }

  .guide-read-more {
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>

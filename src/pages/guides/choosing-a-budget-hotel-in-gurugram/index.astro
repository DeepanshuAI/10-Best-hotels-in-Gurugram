---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import HotelCard from '../../../components/HotelCard.astro';
import { GUIDES } from '../../../data/guides';
import { HOTELS } from '../../../data/hotels';
import { generateArticleSchema, generateBreadcrumbSchema } from '../../../lib/seo';

const guide = GUIDES['choosing-a-budget-hotel-in-gurugram'];
const relatedHotels = HOTELS.filter((h) => guide.relatedHotelSlugs.includes(h.slug)).slice(0, 3);

const breadcrumbs = [
  { label: 'Guides', href: '/guides/where-to-stay-in-gurugram/' },
  { label: 'Choosing a Budget Hotel', href: '/guides/choosing-a-budget-hotel-in-gurugram/' }
];

const articleSchema = generateArticleSchema(guide);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Guides', url: '/guides/where-to-stay-in-gurugram/' },
  { name: guide.title, url: '/guides/choosing-a-budget-hotel-in-gurugram/' },
]);
---

<BaseLayout
  title={guide.metaTitle}
  description={guide.metaDescription}
  canonicalPath="/guides/choosing-a-budget-hotel-in-gurugram/"
  ogType="article"
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <Breadcrumbs items={breadcrumbs} />

  <article class="guide-article-page">
    <header class="guide-masthead container">
      <div class="guide-header-badges">
        <span class="editorial-kicker">Consumer Protection</span>
        <span class="guide-meta-item">{guide.readTime}</span>
        <span class="guide-meta-sep" aria-hidden="true">&bull;</span>
        <span class="guide-meta-item">Updated: {guide.lastUpdated}</span>
      </div>

      <h1 class="guide-h1 font-serif">{guide.title}</h1>
      <p class="lead guide-lead">{guide.summary}</p>

      <div class="guide-author-bar">
        <div class="author-avatar" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
        <div class="author-details">
          <span class="author-name">{guide.author}</span>
          <span class="author-role">Accommodation Quality & Safety Analysts</span>
        </div>
      </div>
    </header>

    <div class="container guide-layout-grid section-padding">
      <div class="guide-main-content">
        <!-- Table of Contents -->
        <nav class="guide-toc card" aria-label="Table of contents">
          <h2 class="toc-title font-serif">Table of Contents</h2>
          <ol class="toc-list" role="list">
            {guide.sections.map((sec) => (
              <li><a href={`#${sec.id}`}>{sec.title}</a></li>
            ))}
          </ol>
        </nav>

        <!-- Sections -->
        {guide.sections.map((sec) => (
          <section class="guide-section-block" id={sec.id} aria-labelledby={`${sec.id}-heading`}>
            <h2 id={`${sec.id}-heading`} class="guide-section-title font-serif">{sec.title}</h2>
            <div class="guide-section-body" set:html={sec.content.replace(/\n\n/g, '<br/><br/>')} />
            
            {sec.keyTakeaways && sec.keyTakeaways.length > 0 && (
              <div class="key-takeaways card">
                <span class="takeaways-label font-serif">Value Protection Rules</span>
                <ul class="takeaways-list" role="list">
                  {sec.keyTakeaways.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        ))}

        <div class="guide-integrity-box card">
          <h3 class="font-serif">Editorial Independence Note</h3>
          <p>
            This budget advisory guide is compiled from verified hospitality audits, municipal lodging safety registers, and guest satisfaction benchmarks. We do not receive compensation or sponsorship from any recommended budget brand.
          </p>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="guide-sidebar" aria-label="Related corridor shortcuts">
        <div class="sidebar-sticky card">
          <h3 class="sidebar-heading">Corridor Directory Hubs</h3>
          <ul class="corridor-links-list" role="list">
            <li><a href="/hotels-near-cyber-city/">DLF Cyber City Hotels &rarr;</a></li>
            <li><a href="/hotels-near-golf-course-road/">Golf Course Road Hotels &rarr;</a></li>
            <li><a href="/hotels-near-udyog-vihar/">Udyog Vihar Hotels &rarr;</a></li>
            <li><a href="/hotels-near-mg-road-gurugram/">MG Road & Sector 29 Hotels &rarr;</a></li>
            <li><a href="/hotels-near-sohna-road/">Sohna Road Hotels &rarr;</a></li>
          </ul>

          <hr class="sidebar-sep" />

          <h3 class="sidebar-heading">Other Traveler Guides</h3>
          <ul class="corridor-links-list" role="list">
            <li><a href="/guides/where-to-stay-in-gurugram/">Where to Stay in Gurugram</a></li>
            <li><a href="/guides/hotels-for-business-travel-in-gurugram/">Business Travel Guide</a></li>
            <li><a href="/how-we-choose-hotels/">Selection Methodology</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <!-- Related Hotel Recommendations -->
    {relatedHotels.length > 0 && (
      <section class="container related-hotels-section section-padding">
        <div class="section-header">
          <span class="editorial-kicker">Recommended Lodging</span>
          <h2 class="section-title font-serif">Featured Value Accommodations</h2>
          <p class="section-subtitle">Verified properties highlighted in our budget advisory guide.</p>
        </div>
        <div class="related-cards-grid">
          {relatedHotels.map((rel) => (
            <HotelCard hotel={rel} />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .guide-masthead {
    padding-top: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .guide-header-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .guide-meta-sep {
    color: var(--border-medium);
  }

  .guide-h1 {
    font-size: 2.35rem;
    line-height: 1.15;
    color: var(--navy-primary);
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .guide-h1 {
      font-size: 3.25rem;
    }
  }

  .guide-lead {
    font-size: 1.15rem;
    line-height: 1.65;
    max-width: 820px;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .guide-author-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-avatar {
    width: 2.25rem;
    height: 2.25rem;
    background-color: var(--navy-subtle);
    color: var(--navy-primary);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--navy-primary);
  }

  .author-role {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .guide-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 1024px) {
    .guide-layout-grid {
      grid-template-columns: 1fr 300px;
    }
  }

  /* Table of Contents */
  .guide-toc {
    padding: 1.75rem;
    margin-bottom: 3rem;
    background-color: var(--bg-card);
  }

  .toc-title {
    font-size: 1.25rem;
    margin-bottom: 0.875rem;
    color: var(--navy-primary);
  }

  .toc-list {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .toc-list a {
    color: var(--forest-primary);
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .toc-list a:hover {
    text-decoration: underline;
    color: var(--forest-hover);
  }

  /* Section Blocks */
  .guide-section-block {
    margin-bottom: 3.5rem;
  }

  .guide-section-title {
    font-size: 1.85rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--navy-primary);
  }

  .guide-section-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    max-width: var(--prose-max);
  }

  .key-takeaways {
    padding: 1.5rem 1.75rem;
    background-color: var(--forest-subtle);
    border: 1px solid var(--forest-border);
    border-radius: var(--radius-sm);
    margin-top: 1.5rem;
  }

  .takeaways-label {
    display: block;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--forest-primary);
    margin-bottom: 0.625rem;
  }

  .takeaways-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .takeaways-list li {
    position: relative;
    padding-left: 1.25rem;
    line-height: 1.55;
  }

  .takeaways-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    font-weight: bold;
    color: var(--forest-primary);
  }

  /* Integrity Box */
  .guide-integrity-box {
    padding: 1.75rem;
    background-color: var(--bg-card);
    border-left: 3px solid var(--navy-primary);
    margin-top: 3rem;
  }

  .guide-integrity-box h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    color: var(--navy-primary);
  }

  .guide-integrity-box p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Sidebar */
  .sidebar-sticky {
    position: sticky;
    top: 5.5rem;
    padding: 1.75rem;
    background-color: var(--bg-card);
  }

  .sidebar-heading {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .corridor-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    font-size: 0.9375rem;
  }

  .corridor-links-list a {
    color: var(--text-primary);
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .corridor-links-list a:hover {
    color: var(--forest-primary);
  }

  .sidebar-sep {
    margin: 1.5rem 0;
    border: 0;
    border-top: 1px solid var(--border-subtle);
  }

  /* Related Section */
  .related-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .related-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .related-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

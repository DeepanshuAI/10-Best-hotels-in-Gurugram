---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE_CONFIG } from '../../lib/site-config';
import { generateBreadcrumbSchema } from '../../lib/seo';

const title = 'Contact Us: Best Hotels in Gurugram Directory (2026)';
const description = 'Get in touch with the editorial team at Best Hotels in Gurugram. Editorial inquiries, research partnerships, and directory feedback.';

const breadcrumbs = [
  { label: 'Contact', href: '/contact/' }
];

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' },
]);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/contact/"
  jsonLd={breadcrumbSchema}
>
  <Breadcrumbs items={breadcrumbs} />

  <article class="contact-page container section-padding">
    <header class="contact-header">
      <div class="kicker-wrap">
        <span class="editorial-kicker">Get in Touch</span>
        <span class="badge badge-navy">Communications</span>
      </div>
      <h1 class="contact-h1 font-serif">Contact Our Editorial Desk</h1>
      <p class="lead contact-lead">
        We welcome communications from travelers, local corporate travel coordinators, hoteliers, and researchers.
      </p>
    </header>

    <div class="contact-layout-grid">
      <!-- Contact Form -->
      <div class="contact-form-col card">
        <h2 class="font-serif">Send a Message</h2>
        <p class="form-subtext">Fill in your details below and our editorial desk will respond within 24 to 48 business hours.</p>

        <form id="contact-form" class="contact-form" data-contact-email={SITE_CONFIG.contactEmail} novalidate>
          <div class="form-group">
            <label for="contact-name">Full Name <span class="required">*</span></label>
            <input type="text" id="contact-name" name="name" required class="form-input" placeholder="e.g. Rahul Sharma" />
          </div>

          <div class="form-group">
            <label for="contact-email">Email Address <span class="required">*</span></label>
            <input type="email" id="contact-email" name="email" required class="form-input" placeholder="e.g. rahul@example.com" />
          </div>

          <div class="form-group">
            <label for="contact-subject">Topic of Inquiry <span class="required">*</span></label>
            <select id="contact-subject" name="subject" required class="form-select">
              <option value="">Select an option...</option>
              <option value="editorial">Editorial Inquiry / Research</option>
              <option value="correction">Hotel Data Correction (See Corrections Page)</option>
              <option value="partnership">Institutional / Academic Research</option>
              <option value="general">General Question</option>
            </select>
          </div>

          <div class="form-group">
            <label for="contact-message">Message <span class="required">*</span></label>
            <textarea id="contact-message" name="message" rows="5" required class="form-textarea" placeholder="How can we assist you with Gurugram accommodation data?"></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Send Message
          </button>

          <div id="form-status-msg" class="form-status-msg" hidden aria-live="polite"></div>
        </form>
      </div>

      <!-- Contact Info Sidebar -->
      <aside class="contact-info-col">
        <div class="info-card card">
          <h3>Direct Communications</h3>
          <dl class="contact-details-list">
            <div class="contact-detail-item">
              <dt>Editorial Desk</dt>
              <dd><a href={`mailto:${SITE_CONFIG.contactEmail}`} class="text-link">{SITE_CONFIG.contactEmail}</a></dd>
            </div>
            <div class="contact-detail-item">
              <dt>Location</dt>
              <dd>Gurugram, Haryana 122002, India</dd>
            </div>
            <div class="contact-detail-item">
              <dt>Operating Hours</dt>
              <dd>Monday – Friday, 9:00 AM – 6:00 PM IST</dd>
            </div>
          </dl>
        </div>

        <div class="info-card card correction-cta-card">
          <div class="correction-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
          </div>
          <h3>Hotel Data Corrections</h3>
          <p>If you are reporting a specific change in room tariffs, contact phone numbers, or property facilities, please use our dedicated corrections form.</p>
          <a href="/corrections/" class="btn btn-outline btn-sm">Submit Correction &rarr;</a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .contact-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 3rem;
  }

  .kicker-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .contact-h1 {
    font-size: 2.35rem;
    line-height: 1.15;
    color: var(--navy-primary);
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .contact-h1 {
      font-size: 3.25rem;
    }
  }

  .contact-lead {
    font-size: 1.1875rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 780px;
    margin-left: auto;
    margin-right: auto;
  }

  .contact-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .contact-layout-grid {
      grid-template-columns: 1fr 360px;
    }
  }

  .contact-form-col {
    padding: 2rem;
  }

  @media (min-width: 768px) {
    .contact-form-col {
      padding: 2.5rem;
    }
  }

  .contact-form-col h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .form-subtext {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .required {
    color: #DC2626;
  }

  .form-input, .form-select, .form-textarea {
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    background-color: var(--bg-card);
    color: var(--text-primary);
    font-size: 0.9375rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--emerald-primary);
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
  }

  .form-status-msg {
    padding: 0.875rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    margin-top: 1rem;
  }

  .form-status-success {
    background-color: var(--emerald-light);
    color: var(--emerald-hover);
    border: 1px solid var(--emerald-border);
  }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    padding: 1.75rem;
  }

  .info-card h3 {
    font-size: 1.125rem;
    margin-bottom: 1rem;
  }

  .contact-details-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-detail-item dt {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-bottom: 0.15rem;
  }

  .contact-detail-item dd {
    font-size: 0.9375rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .correction-cta-card {
    background-color: var(--bg-subtle);
    border-left: 4px solid var(--emerald-primary);
  }

  .correction-icon {
    color: var(--emerald-primary);
    margin-bottom: 0.75rem;
  }

  .correction-cta-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
  }
</style>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusMsg = document.getElementById('form-status-msg');

    if (!form || !statusMsg) return;

    const contactEmail = form.dataset.contactEmail || 'raijin4551@gmail.com';

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim();
      const subjectType = (document.getElementById('contact-subject') as HTMLSelectElement)?.value;
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value.trim();

      if (!name || !email || !message) {
        statusMsg.hidden = false;
        statusMsg.className = 'form-status-msg';
        statusMsg.style.backgroundColor = '#FEE2E2';
        statusMsg.style.color = '#B91C1C';
        statusMsg.textContent = 'Please complete all required fields before submitting.';
        return;
      }

      const subject = encodeURIComponent(`[Gurugram Directory Inquiry] ${subjectType || 'General'} from ${name}`);
      const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nTopic: ${subjectType}\n\nMessage:\n${message}`);
      const mailtoUrl = `mailto:${contactEmail}?subject=${subject}&body=${body}`;

      window.location.href = mailtoUrl;

      statusMsg.hidden = false;
      statusMsg.className = 'form-status-msg form-status-success';
      statusMsg.innerHTML = `Your email client is opening with your message pre-filled to <strong>${contactEmail}</strong>.<br /><br />You can also reach out directly via email or on our <a href="https://github.com/DeepanshuAI/10-Best-hotels-in-Gurugram" target="_blank" rel="noopener noreferrer" style="text-decoration: underline; font-weight: bold;">GitHub repository</a>.`;
    });
  }

  setupContactForm();
  document.addEventListener('astro:after-swap', setupContactForm);
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RatingBadge from '../../components/RatingBadge.astro';
import HotelCard from '../../components/HotelCard.astro';
import { HOTELS } from '../../data/hotels';
import type { HotelRecord } from '../../data/types';
import { formatINR } from '../../lib/site-config';
import { generateHotelSchema, generateBreadcrumbSchema } from '../../lib/seo';

export async function getStaticPaths() {
  return HOTELS.map((hotel) => ({
    params: { slug: hotel.slug },
    props: { hotel },
  }));
}

interface Props {
  hotel: HotelRecord;
}

const { hotel } = Astro.props;

// Determine overall directory rank and category rank
const hotelRank = HOTELS.findIndex((h) => h.id === hotel.id) + 1;
const categoryHotels = HOTELS.filter((h) => h.category === hotel.category);
const categoryRank = categoryHotels.findIndex((h) => h.id === hotel.id) + 1;

const categoryNames: Record<string, string> = {
  luxury: '5-Star Luxury',
  business: 'Corporate Business',
  budget: 'Smart Budget',
  resort: 'Resort Sanctuary',
  boutique: 'Boutique',
};

const pageTitle = `${hotel.officialName} (Ranked #${hotelRank}) | Gurugram Hotel Dossier & Transit Guide`;
const pageDescription = `Editorial dossier and verified facts for ${hotel.officialName} in ${hotel.address.locality}. Ranked #${hotelRank} in Gurugram. Verified starting rates from ${formatINR(hotel.indicativeStartingRateINR)}, metro transit times, workstation facilities & honest caveats.`;

const breadcrumbs = [
  { label: 'Hotels', href: '/' },
  { label: `Ranked #${hotelRank}: ${hotel.officialName}`, href: `/hotels/${hotel.slug}/` }
];

const hotelSchema = generateHotelSchema(hotel);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Hotels', url: '/' },
  { name: hotel.officialName, url: `/hotels/${hotel.slug}/` },
]);

// Find related hotels in the same primary district or category
const relatedHotels = HOTELS
  .filter((h) => h.id !== hotel.id && (h.primaryDistrict === hotel.primaryDistrict || h.category === hotel.category))
  .slice(0, 3);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/hotels/${hotel.slug}/`}
  ogImage={hotel.heroImage.src}
  jsonLd={[hotelSchema, breadcrumbSchema]}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Editorial Hotel Dossier -->
  <article class="hotel-profile-article">
    <header class="profile-masthead container">
      <!-- Ranking Position Banner -->
      <div class="ranking-position-strip">
        <div class="ranking-number-chip">
          <span class="chip-hash">#</span>
          <span class="chip-val">{String(hotelRank).padStart(2, '0')}</span>
        </div>
        <div class="ranking-meta-info">
          <span class="ranking-label">Gurugram Editorial Ranking</span>
          <span class="ranking-sublabel">
            Ranked #{hotelRank} of 18 overall &bull; #{categoryRank} in {categoryNames[hotel.category] || hotel.category}
          </span>
        </div>
        <div class="ranking-audit-stamp">
          <span class="stamp-dot" aria-hidden="true"></span>
          <span>Verified Oct 2026</span>
        </div>
      </div>

      <div class="profile-header-kicker">
        <span class="editorial-kicker">{hotel.address.locality} &bull; {hotel.primaryDistrict} Corridor</span>
        <span class="badge badge-brass">{hotel.priceTier} Tier</span>
        <span class="corridor-tag">Official Brand: {hotel.brand}</span>
      </div>

      <h1 class="profile-headline font-serif">{hotel.officialName}</h1>

      <p class="lead profile-lead">{hotel.summary}</p>

      <div class="profile-meta-bar">
        <div class="meta-block">
          <RatingBadge benchmark={hotel.ratingBenchmark} size="md" />
        </div>
        <span class="meta-sep" aria-hidden="true">&bull;</span>
        <div class="meta-block address-meta">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>{hotel.address.street}, {hotel.address.locality}, Gurugram {hotel.address.postalCode}</span>
        </div>
      </div>
    </header>

    <!-- Restrained Supporting Photography -->
    <div class="container hero-media-container">
      <figure class="profile-hero-figure card">
        <img
          src={hotel.heroImage.src}
          alt={hotel.heroImage.alt}
          width="1100"
          height="500"
          fetchpriority="high"
          class="profile-hero-img"
        />
        <figcaption class="profile-hero-caption">
          <strong>Architectural Study:</strong> {hotel.heroImage.caption}
        </figcaption>
      </figure>
    </div>

    <!-- Main Content Layout Grid -->
    <div class="container profile-grid-layout">
      <!-- Left Column: Editorial Dossier Content -->
      <div class="profile-content-column">
        <!-- Directory Selection Rationale (Prominent Placement) -->
        <section class="editorial-section rationale-section card" aria-labelledby="editorial-heading">
          <div class="rationale-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
            <h2 id="editorial-heading" class="rationale-title font-serif">Directory Selection Rationale & Assessment</h2>
          </div>
          <p class="rationale-body">{hotel.editorialRationale}</p>
          <div class="rationale-meta">
            <span><strong>Primary Audit Source:</strong> {hotel.verificationSource}</span>
            <span class="meta-dot" aria-hidden="true">&bull;</span>
            <span><strong>Last Researched:</strong> {hotel.lastVerifiedDate}</span>
          </div>
        </section>

        <!-- Overview Section -->
        <section class="editorial-section" aria-labelledby="overview-heading">
          <h2 id="overview-heading" class="section-heading font-serif">Property Overview & Context</h2>
          <div class="prose-body">
            <p>{hotel.inDepthDescription}</p>
          </div>
        </section>

        <!-- Best For / Suitability Section -->
        <section class="editorial-section" aria-labelledby="best-for-heading">
          <h2 id="best-for-heading" class="section-heading font-serif">Who This Hotel Suits Best</h2>
          <ul class="editorial-suitability-list" role="list">
            {hotel.bestFor.map((item: string) => (
              <li class="suitability-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="suitability-icon" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Balanced Evaluation: Strengths vs Considerations -->
        <section class="editorial-section" aria-labelledby="evaluation-heading">
          <h2 id="evaluation-heading" class="section-heading font-serif">Balanced Editorial Evaluation</h2>
          <div class="evaluation-columns">
            <!-- Strengths -->
            <div class="eval-pane eval-strengths">
              <div class="eval-pane-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/>
                </svg>
                <h3>Key Strengths</h3>
              </div>
              <ul class="eval-items-list" role="list">
                {hotel.keyStrengths.map((str: string) => (
                  <li>{str}</li>
                ))}
              </ul>
            </div>

            <!-- Considerations -->
            <div class="eval-pane eval-considerations">
              <div class="eval-pane-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                  <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <h3>Things to Keep in Mind</h3>
              </div>
              <ul class="eval-items-list" role="list">
                {hotel.considerations.map((con: string) => (
                  <li>{con}</li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- Transit Reality Section -->
        <section class="editorial-section" aria-labelledby="transit-heading">
          <h2 id="transit-heading" class="section-heading font-serif">The Gurugram Transit Reality</h2>
          <div class="transit-matrix card">
            <div class="transit-metrics-grid">
              <div class="transit-cell">
                <span class="cell-kicker">Nearest Metro Station</span>
                <span class="cell-primary">{hotel.transit.nearestMetroStation}</span>
                <span class="cell-sub">{hotel.transit.metroLine} &bull; {hotel.transit.distanceToMetroKm} km {
                  hotel.transit.walkingTimeToMetroMin !== null
                    ? `(${hotel.transit.walkingTimeToMetroMin} min walk)`
                    : `(~${hotel.transit.driveTimeToMetroMin || Math.round(hotel.transit.distanceToMetroKm * 2)} min drive)`
                }</span>
              </div>

              <div class="transit-cell">
                <span class="cell-kicker">DLF Cyber City Commute</span>
                <span class="cell-primary">{hotel.transit.driveTimeToCyberCityMin} min drive</span>
                <span class="cell-sub">Via direct highway or underpass loop</span>
              </div>

              <div class="transit-cell">
                <span class="cell-kicker">Indira Gandhi Airport (DEL T3)</span>
                <span class="cell-primary">{hotel.transit.driveTimeToIGI_T3Min} min drive</span>
                <span class="cell-sub">Access via NH-48 or Northern Peripheral Road</span>
              </div>

              <div class="transit-cell">
                <span class="cell-kicker">Expressway Access Point</span>
                <span class="cell-primary">{hotel.transit.highwayAccess}</span>
              </div>
            </div>

            <div class="transit-advisory">
              <strong>Local Commute Tip:</strong> {hotel.transit.transitTips}
            </div>
          </div>
        </section>

        <!-- Verified Amenities Matrix -->
        <section class="editorial-section" aria-labelledby="amenities-heading">
          <h2 id="amenities-heading" class="section-heading font-serif">Verified Property Amenities</h2>
          <div class="amenities-chips-grid">
            {hotel.verifiedAmenities.map((amenity: string) => (
              <div class="amenity-chip-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span>{amenity}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Corporate Facilities -->
        <section class="editorial-section" aria-labelledby="business-facilities-heading">
          <h2 id="business-facilities-heading" class="section-heading font-serif">Corporate & Meeting Facilities</h2>
          <div class="business-facilities-grid">
            {hotel.businessFacilities.map((bf: string) => (
              <div class="facility-row card">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="facility-icon" aria-hidden="true">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                </svg>
                <span>{bf}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Dining Venues -->
        <section class="editorial-section" aria-labelledby="dining-heading">
          <h2 id="dining-heading" class="section-heading font-serif">On-Site Dining Venues</h2>
          <div class="dining-list">
            {hotel.diningVenues.map((venue: string) => (
              <div class="dining-item card">
                <div class="dining-glyph" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
                    <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                    <line x1="6" y1="1" x2="6" y2="4"/>
                    <line x1="10" y1="1" x2="10" y2="4"/>
                    <line x1="14" y1="1" x2="14" y2="4"/>
                  </svg>
                </div>
                <div class="dining-text">
                  <p>{venue}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Corrections Notice -->
        <div class="corrections-box card">
          <p>
            Notice a discrepancy in room rates, transit times, or meeting specifications? 
            <a href="/corrections/" class="text-link">Submit a factual correction</a> to help keep this directory accurate.
          </p>
        </div>
      </div>

      <!-- Right Column: Editorial Factsheet & External Reference Links -->
      <aside class="profile-sidebar-column" aria-label="Hotel factsheet & verified specifications">
        <div class="sidebar-factsheet-card card">
          <div class="factsheet-header">
            <span class="factsheet-label">Verified Market Tariff</span>
            <div class="tariff-price-row">
              <span class="tariff-val">{formatINR(hotel.indicativeStartingRateINR)}</span>
              <span class="tariff-unit">/ night</span>
            </div>
            <span class="tariff-recorded-date">Direct portal baseline ({hotel.rateVerificationDate})</span>
            <p class="tariff-conditions-note">
              {hotel.pricingConditions || 'Indicative starting rate excluding taxes, recorded from official brand booking channel. Rates fluctuate with corporate peak demand.'}
            </p>
          </div>

          <!-- Official External Reference Links (Restrained, not aggressive booking widgets) -->
          <div class="reference-links-block">
            <a
              href={hotel.officialWebsite}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline btn-full-width ref-btn"
            >
              Visit Official Property Website
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
            
            <a
              href={hotel.officialBookingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="ref-portal-link"
            >
              Check brand reservation portal ↗
            </a>
          </div>

          <hr class="sidebar-sep" />

          <!-- Specifications Definition List -->
          <div class="specs-block">
            <h3 class="specs-heading">Property Factsheet</h3>
            <dl class="specs-table">
              <div class="spec-entry">
                <dt>Directory Rank</dt>
                <dd><strong>#{hotelRank} in Gurugram</strong></dd>
              </div>
              <div class="spec-entry">
                <dt>Stay Tier</dt>
                <dd>{categoryNames[hotel.category] || hotel.category}</dd>
              </div>
              <div class="spec-entry">
                <dt>Brand Group</dt>
                <dd>{hotel.brand}</dd>
              </div>
              <div class="spec-entry">
                <dt>Corridor</dt>
                <dd>{hotel.primaryDistrict}</dd>
              </div>
              <div class="spec-entry">
                <dt>Front Desk</dt>
                <dd><a href={`tel:${hotel.phone}`} class="tel-number">{hotel.phone}</a></dd>
              </div>
              <div class="spec-entry">
                <dt>Postal Code</dt>
                <dd>{hotel.address.postalCode}</dd>
              </div>
              <div class="spec-entry">
                <dt>Coordinates</dt>
                <dd>{hotel.coordinates.latitude.toFixed(4)}, {hotel.coordinates.longitude.toFixed(4)}</dd>
              </div>
            </dl>
          </div>

          <!-- Non-Commercial Assurance -->
          <div class="sidebar-assurance-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="16" x2="12" y2="12"/>
              <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            <span>Independent directory dossier. We do not process transactions or accept booking commissions.</span>
          </div>
        </div>
      </aside>
    </div>

    <!-- Related / Alternative Properties Comparison Section -->
    {relatedHotels.length > 0 && (
      <section class="container related-hotels-section section-padding">
        <div class="section-header">
          <span class="editorial-kicker">Corridor & Tier Alternatives</span>
          <h2 class="section-title font-serif">Compare Alternatives in {hotel.primaryDistrict}</h2>
          <p class="section-subtitle">Examine other verified accommodations operating in the same transit corridor.</p>
        </div>
        <div class="related-cards-grid">
          {relatedHotels.map((rel: HotelRecord) => (
            <HotelCard hotel={rel} />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  /* Profile Header */
  .profile-masthead {
    padding-top: 2rem;
    padding-bottom: 1.5rem;
  }

  /* Ranking Position Strip */
  .ranking-position-strip {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-neutral);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    margin-bottom: 1.5rem;
  }

  .ranking-number-chip {
    display: flex;
    align-items: baseline;
    font-family: var(--font-serif);
    font-weight: 800;
    color: var(--forest-primary);
    background-color: var(--forest-soft);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-xs);
    border: 1px solid rgba(20, 83, 45, 0.2);
    line-height: 1;
  }

  .chip-hash {
    font-size: 0.85rem;
    margin-right: 1px;
  }

  .chip-val {
    font-size: 1.4rem;
  }

  .ranking-meta-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .ranking-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .ranking-sublabel {
    font-size: 0.84375rem;
    font-weight: 600;
    color: var(--navy-primary);
  }

  .ranking-audit-stamp {
    margin-left: auto;
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--forest-primary);
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .ranking-audit-stamp {
      display: flex;
    }
  }

  .stamp-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--forest-primary);
  }

  .profile-header-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
  }

  .corridor-tag {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .profile-headline {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    line-height: 1.15;
    margin-bottom: 0.875rem;
    color: var(--navy-primary);
  }

  .profile-lead {
    font-size: 1.125rem;
    max-width: 820px;
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .profile-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .meta-sep {
    color: var(--border-neutral);
  }

  .address-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
  }

  /* Restrained Hero Media */
  .hero-media-container {
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .profile-hero-figure {
    overflow: hidden;
    background-color: var(--bg-surface);
    margin: 0;
  }

  .profile-hero-img {
    width: 100%;
    max-height: 440px;
    object-fit: cover;
    display: block;
    background-color: var(--bg-image-fallback);
  }

  .profile-hero-caption {
    padding: 0.75rem 1.25rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    background-color: var(--bg-subtle);
    border-top: 1px solid var(--border-subtle);
  }

  /* Main Grid Layout */
  .profile-grid-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .profile-grid-layout {
      grid-template-columns: 1fr 340px;
    }
  }

  /* Editorial Sections */
  .editorial-section {
    margin-bottom: 2.5rem;
  }

  .section-heading {
    font-size: 1.5rem;
    color: var(--navy-primary);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Prominent Rationale Section */
  .rationale-section {
    padding: 1.75rem;
    background-color: var(--bg-surface);
    border-left: 4px solid var(--forest-primary);
    margin-bottom: 2.5rem;
  }

  .rationale-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
    color: var(--forest-primary);
  }

  .rationale-title {
    font-size: 1.25rem;
    color: var(--navy-primary);
    margin: 0;
  }

  .rationale-body {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-primary);
    margin: 0 0 1rem 0;
  }

  .rationale-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    padding-top: 0.65rem;
    border-top: 1px solid var(--border-subtle);
  }

  .meta-dot {
    color: var(--border-neutral);
  }

  .prose-body p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0 0 1rem 0;
  }

  /* Suitability List */
  .editorial-suitability-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .suitability-item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    color: var(--navy-secondary);
    font-weight: 500;
  }

  .suitability-icon {
    color: var(--forest-primary);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }


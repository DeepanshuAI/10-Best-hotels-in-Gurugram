---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found (404) | Best Hotels in Gurugram';
const description = 'The accommodation resource or hotel profile you requested was not found. Explore our directory of verified Gurugram hotels.';
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
>
  <div class="container not-found-container section-padding">
    <div class="not-found-card card">
      <div class="not-found-icon" aria-hidden="true">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>

      <span class="badge badge-neutral">Error 404 &bull; Page Not Found</span>

      <h1 class="not-found-title font-serif">We couldn't locate that hotel resource</h1>

      <p class="not-found-lead">
        The route you requested may have moved during our latest directory restructuring, or the property profile is currently undergoing verification.
      </p>

      <div class="not-found-actions">
        <a href="/" class="btn btn-primary">
          Return to Hotel Directory
        </a>
        <a href="/guides/where-to-stay-in-gurugram/" class="btn btn-outline">
          Explore Gurugram Area Guide
        </a>
      </div>

      <hr class="not-found-divider" />

      <div class="popular-routes-box">
        <h3>Popular Business & Accommodation Hubs</h3>
        <div class="popular-links-grid">
          <a href="/luxury-hotels-in-gurugram/" class="popular-link">Luxury Hotels &rarr;</a>
          <a href="/business-hotels-in-gurugram/" class="popular-link">Business Stays &rarr;</a>
          <a href="/budget-hotels-in-gurugram/" class="popular-link">Verified Budget Hotels &rarr;</a>
          <a href="/hotels-near-cyber-city/" class="popular-link">Near DLF Cyber City &rarr;</a>
          <a href="/hotels-near-golf-course-road/" class="popular-link">Golf Course Road Stays &rarr;</a>
          <a href="/hotels-near-udyog-vihar/" class="popular-link">Near Udyog Vihar &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-container {
    max-width: 760px;
    margin: 2rem auto;
  }

  .not-found-card {
    padding: 3rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .not-found-icon {
    width: 4.5rem;
    height: 4.5rem;
    background-color: var(--bg-subtle);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .not-found-card .badge {
    margin-bottom: 1rem;
  }

  .not-found-title {
    font-size: 1.875rem;
    margin-bottom: 0.75rem;
  }

  .not-found-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 550px;
    margin-bottom: 2rem;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .not-found-divider {
    width: 100%;
    border: 0;
    border-top: 1px solid var(--border-subtle);
    margin-bottom: 2rem;
  }

  .popular-routes-box {
    width: 100%;
    text-align: left;
  }

  .popular-routes-box h3 {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-bottom: 1rem;
    text-align: center;
  }

  .popular-links-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .popular-links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .popular-link {
    display: block;
    padding: 0.75rem 1rem;
    background-color: var(--bg-subtle);
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .popular-link:hover {
    background-color: var(--emerald-light);
    color: var(--emerald-hover);
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { HOTELS } from '../../data/hotels';
import { generateBreadcrumbSchema } from '../../lib/seo';
import { SITE_CONFIG } from '../../lib/site-config';

const title = 'Submit a Correction: Hotel Data Integrity & Verification (2026)';
const description = 'Report factual discrepancies, updated room tariffs, altered hotel phone numbers, or changed amenities in our Gurugram hotel directory.';

const breadcrumbs = [
  { label: 'Corrections', href: '/corrections/' }
];

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Corrections', url: '/corrections/' },
]);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/corrections/"
  jsonLd={breadcrumbSchema}
>
  <Breadcrumbs items={breadcrumbs} />

  <article class="corrections-page container section-padding">
    <header class="corrections-header">
      <span class="badge badge-gold">Data Integrity Protocol</span>
      <h1 class="corrections-h1">Submit a Factual Correction</h1>
      <p class="lead corrections-lead">
        We are committed to factual accuracy and transparency. If a hotel has adjusted its starting tariffs, updated its telephone contact, renovated facilities, or altered restaurant venues, please submit the details below for prompt verification.
      </p>
    </header>

    <div class="corrections-layout-grid">
      <div class="corrections-form-col card">
        <h2>Correction Request Form</h2>
        <p class="subtext">All submissions are reviewed against official hotel documentation before public profiles are updated.</p>

        <form id="correction-form" class="correction-form" data-contact-email={SITE_CONFIG.contactEmail} novalidate>
          <div class="form-group">
            <label for="corr-hotel">Property Name <span class="required">*</span></label>
            <select id="corr-hotel" name="hotel" required class="form-select">
              <option value="">Select a Gurugram hotel...</option>
              {HOTELS.map((hotel) => (
                <option value={hotel.slug}>{hotel.officialName}</option>
              ))}
              <option value="other">Other / New Property</option>
            </select>
          </div>

          <div class="form-group">
            <label for="corr-field">Field to Correct <span class="required">*</span></label>
            <select id="corr-field" name="field" required class="form-select">
              <option value="">Select field...</option>
              <option value="rate">Starting Tariff / Pricing</option>
              <option value="phone">Telephone Number / Contact</option>
              <option value="address">Address / Road Access</option>
              <option value="amenity">Amenities / Facility Change</option>
              <option value="transit">Metro / Transit Information</option>
              <option value="other">Other Detail</option>
            </select>
          </div>

          <div class="form-group">
            <label for="corr-details">Correct Information & Supporting Evidence <span class="required">*</span></label>
            <textarea
              id="corr-details"
              name="details"
              rows="5"
              required
              class="form-textarea"
              placeholder="Please provide the exact verified facts and a link to official documentation (e.g., official hotel press release, booking engine update, or municipal registry)."
            ></textarea>
          </div>

          <div class="form-group">
            <label for="corr-submitter-role">Your Relationship to Property <span class="required">*</span></label>
            <select id="corr-submitter-role" name="role" required class="form-select">
              <option value="">Select relationship...</option>
              <option value="guest">Recent Hotel Guest</option>
              <option value="hotelier">Hotel Management / Corporate PR</option>
              <option value="local">Local Resident / Corporate Travel Coordinator</option>
              <option value="researcher">Independent Researcher</option>
            </select>
          </div>

          <div class="form-group">
            <label for="corr-email">Your Contact Email <span class="required">*</span></label>
            <input type="email" id="corr-email" name="email" required class="form-input" placeholder="e.g. name@domain.com" />
            <span class="input-hint">Used strictly if our audit team requires clarification regarding your correction.</span>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Submit Correction for Audit
          </button>

          <div id="corr-status-msg" class="corr-status-msg" hidden aria-live="polite"></div>
        </form>
      </div>

      <aside class="corrections-sidebar">
        <div class="sidebar-box card">
          <h3>Verification Protocol</h3>
          <ol class="protocol-list" role="list">
            <li><strong>Intake:</strong> Reports sent via email or GitHub are reviewed directly by the project maintainer.</li>
            <li><strong>Cross-Check:</strong> The factual claim is verified against official hotel reservation engines, corporate notices, or municipal records.</li>
            <li><strong>Codebase Update:</strong> Once verified, the listing data is updated in the project repository and redeployed.</li>
          </ol>
        </div>

        <div class="sidebar-box card">
          <h3>Direct Communications</h3>
          <p>For urgent corrections or official inquiries, please email directly at <a href={`mailto:${SITE_CONFIG.contactEmail}`} class="text-link">{SITE_CONFIG.contactEmail}</a> or open an issue on our <a href="https://github.com/DeepanshuAI/10-Best-hotels-in-Gurugram/issues" target="_blank" rel="noopener noreferrer" class="text-link">GitHub Issues Tracker</a>.</p>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .corrections-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 3rem;
  }

  .corrections-header .badge {
    margin-bottom: 0.875rem;
  }

  .corrections-h1 {
    font-size: 2.25rem;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .corrections-h1 {
      font-size: 2.875rem;
    }
  }

  .corrections-lead {
    font-size: 1.125rem;
  }

  .corrections-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .corrections-layout-grid {
      grid-template-columns: 1fr 360px;
    }
  }

  .corrections-form-col {
    padding: 2rem;
  }

  @media (min-width: 768px) {
    .corrections-form-col {
      padding: 2.5rem;
    }
  }

  .corrections-form-col h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .subtext {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }

  .correction-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .required {
    color: #DC2626;
  }

  .input-hint {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .form-input, .form-select, .form-textarea {
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    background-color: var(--bg-card);
    color: var(--text-primary);
    font-size: 0.9375rem;
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--emerald-primary);
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
  }

  .corr-status-msg {
    padding: 0.875rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    margin-top: 1rem;
  }

  .corr-status-success {
    background-color: var(--emerald-light);
    color: var(--emerald-hover);
    border: 1px solid var(--emerald-border);
  }

  .corrections-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-box {
    padding: 1.75rem;
  }

  .sidebar-box h3 {
    font-size: 1.125rem;
    margin-bottom: 1rem;
  }

  .protocol-list {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .sidebar-box p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 0;
  }
</style>

<script>
  function setupCorrectionForm() {
    const form = document.getElementById('correction-form') as HTMLFormElement | null;
    const statusMsg = document.getElementById('corr-status-msg');

    if (!form || !statusMsg) return;

    const contactEmail = form.dataset.contactEmail || 'raijin4551@gmail.com';

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const hotel = (document.getElementById('corr-hotel') as HTMLSelectElement)?.value;
      const field = (document.getElementById('corr-field') as HTMLSelectElement)?.value;
      const details = (document.getElementById('corr-details') as HTMLTextAreaElement)?.value.trim();
      const role = (document.getElementById('corr-submitter-role') as HTMLSelectElement)?.value;
      const email = (document.getElementById('corr-email') as HTMLInputElement)?.value.trim();

      if (!hotel || !details || !email) {
        statusMsg.hidden = false;
        statusMsg.className = 'corr-status-msg';
        statusMsg.style.backgroundColor = '#FEE2E2';
        statusMsg.style.color = '#B91C1C';
        statusMsg.textContent = 'Please complete all required fields and provide supporting evidence.';
        return;
      }

      const subject = encodeURIComponent(`[Hotel Data Correction] ${hotel} - ${field}`);
      const body = encodeURIComponent(
        `Hotel: ${hotel}\nField: ${field}\nDetails & Source Link: ${details}\nSubmitter Role: ${role}\nSubmitter Contact: ${email}`
      );
      const mailtoUrl = `mailto:${contactEmail}?subject=${subject}&body=${body}`;

      window.location.href = mailtoUrl;

      statusMsg.hidden = false;
      statusMsg.className = 'corr-status-msg corr-status-success';
      statusMsg.innerHTML = `Your email client is opening with your formatted report addressed to <strong>${contactEmail}</strong>.<br /><br />Alternatively, you can open an issue directly on our <a href="https://github.com/DeepanshuAI/10-Best-hotels-in-Gurugram/issues" target="_blank" rel="noopener noreferrer" style="text-decoration: underline; font-weight: bold;">GitHub Issues Tracker</a>.`;
    });
  }

  setupCorrectionForm();
  document.addEventListener('astro:after-swap', setupCorrectionForm);
</script>
